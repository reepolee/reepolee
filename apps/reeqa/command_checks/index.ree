{#layout("layout")}
{#with props}
	<div class="min-w-0 w-full p-4 space-y-6">
		<header>
			<h1 class="text-xl font-bold">{_ ui.title}</h1>
			<p class="mt-1 text-sm text-text-secondary">{_ ui.description}</p>
		</header>

		{#if form_error}<app-banner type="red">{= props.form_error }</app-banner>{/if}
		{#if active_run}<app-banner type="blue">{_ ui.active_run}: <a class="font-bold underline" href="{~ localized_path(`/results/run/${props.active_run.id}`) }">{= props.active_run.suite_name }</a></app-banner>{/if}

		{#if projects.length === 0}
			<app-banner type="blue">{_ ui.no_projects} <a class="font-bold underline" href="{~ localized_path('/projects') }">{_ actions.add_project}</a></app-banner>
		{:else}
			<section>
				<h2 class="font-semibold">{_ command_checks.title}</h2>
				<p class="mt-1 text-sm text-text-secondary">{_ command_checks.description}</p>
				<div class="mt-3 grid reeman-card-grid gap-3">
					{#each suites as suite}
						<form method="POST" action="{~ localized_path('/command-checks/suite') }" class="flex flex-col gap-3 rounded-md border border-border bg-surface p-4">
							<input type="hidden" name="_csrf_token" value="{= csrf_token }" />
							<input type="hidden" name="suite_code" value="{= suite.code }" />
							<div>
								<h3 class="font-semibold">{= suite.name }</h3>
								<p class="mt-1 text-sm text-text-secondary">{= suite.description }</p>
							</div>
							<code class="rounded bg-surface-sunken px-2 py-1 text-xs">{= suite.command.join(' ') }</code>
							{#if !suite.available}<p class="text-xs font-semibold text-brand">{_ command_checks.script_unavailable}: {= suite.required_script }</p>{/if}
							<div class="mt-auto"><button type="submit" class="button primary" {#if busy || !suite.available}disabled{/if}>{_ actions.run_check}</button></div>
						</form>
					{/each}
				</div>
			</section>

			<section class="space-y-3">
				<div class="flex flex-wrap items-center gap-3">
					<h2 class="font-semibold">{_ ui.history_title}</h2>
					{#if runs.length > 0}<confirm-dialog trigger-class="button primary text-xs" confirm-class="button danger" form-path="/command-checks/clear" title="{_ actions.clear}" trigger-text="{_ actions.clear}" message="{_ confirm.clear}" confirm-text="{_ actions.confirm_clear}" cancel-text="{_ actions.cancel}"></confirm-dialog>{/if}
				</div>
				{#if runs.length === 0}
					<p class="text-sm text-text-secondary">{_ ui.no_runs}</p>
				{:else}
					<ol class="list-none divide-y divide-border bg-surface-raised shadow-lg [&>li]:m-0">
						{#each runs as run}
							<li>
								<a href="{~ localized_path(`/results/run/${run.id}`) }" class="grid gap-3 px-4 py-3 hover:bg-neutral-100 sm:grid-cols-[9rem_minmax(0,1fr)_8rem_11rem] sm:items-center">
									<div><span class="pill-layout text-xs font-bold {= run.status_class }">{= run.status_label }</span></div>
									<div class="min-w-0"><div class="font-semibold">{= run.suite_name }</div><div class="mt-1 truncate text-xs text-text-secondary">{= run.command_display }</div></div>
									<div><span class="text-xs text-text-secondary">{= run.duration_display }</span></div>
									<div class="text-xs text-text-secondary">{= run.started_display }</div>
								</a>
							</li>
						{/each}
					</ol>
				{/if}
			</section>
		{/if}
	</div>
	<script src="/dialog-confirm.js?v={= version}"></script>
{/with}
