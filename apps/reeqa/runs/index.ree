{#layout("dashboard/layout")}
{#with props}
	<div class="w-full py-4 space-y-4">
		<header class="px-4">
			<h1 class="text-xl font-bold">{_ ui.title}</h1>
			<p class="mt-1 text-sm text-text-secondary">{_ ui.description}</p>
			{#if runs.length > 0}<div class="mt-3 flex flex-wrap gap-2"><confirm-dialog trigger-class="button primary text-xs" confirm-class="button danger" form-path="/runs/clear" title="{_ actions.clear}" trigger-text="{_ actions.clear}" message="{_ confirm.clear}" confirm-text="{_ actions.do_it}" cancel-text="{_ actions.cancel}"></confirm-dialog></div>{/if}
		</header>

		{#if active_run}
			<div class="px-4">
				<app-banner type="blue">{_ ui.active_run}: <a class="font-bold underline" href="{~ localized_path(`/runs/${props.active_run.id}`) }">{= props.active_run.suite_name }</a></app-banner>
			</div>
		{/if}

		{#if runs.length === 0}
			<p class="px-4 text-sm text-text-secondary">{_ ui.no_runs}</p>
		{:else}
			<div class="grid w-full gap-x-4 bg-surface-raised shadow-lg" style="grid-template-columns: 12ch 1fr 18ch 22ch">
				<div class="col-span-full grid grid-cols-subgrid bg-neutral-200 font-semibold *:px-2 *:py-2 sticky top-0">
					<div>{_ labels.status}</div>
					<div>{_ labels.suite}</div>
					<div>{_ labels.duration}</div>
					<div>{_ labels.started}</div>
				</div>
				{#each runs as run}
					<a href="{~ localized_path(`/runs/${run.id}`) }" class="col-span-full grid grid-cols-subgrid border-b border-neutral-200 *:px-2 *:py-2 hover:bg-neutral-100">
						<div><span class="pill-layout text-xs font-bold {= run.status_class }">{= run.status_label }</span></div>
						<div>
							<div class="font-semibold">{= run.suite_name }</div>
							<div class="text-xs text-text-secondary">{= run.project_name }</div>
							<code class="text-xs text-text-secondary">{= run.command_display }</code>
						</div>
						<div>{= run.duration_display }</div>
						<div class="text-xs text-text-secondary">{= run.started_display }</div>
					</a>
				{/each}
			</div>
		{/if}
	</div>

	<script src="/dialog-confirm.js?v={= version}"></script>
{/with}
