{#layout("dashboard/layout")}
{#with props}
	<div class="min-w-0 w-full p-4 space-y-6">
		<header>
			<h1 class="text-xl font-bold">{_ ui.title}</h1>
			<p class="mt-1 text-sm text-text-secondary">{_ ui.description}</p>
		</header>

		{#if form_error}
			<app-banner type="red">{= props.form_error }</app-banner>
		{/if}
		{#if active_visual_run}
			<app-banner type="blue">{_ ui.visual_run_active}:
				<a class="font-bold underline" href="{~ localized_path(`/visual-runs/${props.active_visual_run.id}`) }">{= props.active_visual_run.project_name }</a>
			</app-banner>
		{/if}
		{#if active_run}
			<app-banner type="blue">{_ ui.qa_run_active}:
				<a class="font-bold underline" href="{~ localized_path(`/results/run/${props.active_run.id}`) }">{= props.active_run.suite_name }</a>
			</app-banner>
		{/if}

		{#if projects.length === 0}
			<app-banner type="blue">{_ ui.no_projects}
				<a
					class="font-bold underline"
					href="{~ localized_path('/projects/new') }"
				>
					{_ actions.add_project}
				</a>
			</app-banner>
		{:else}
			<article class="grid gap-5 rounded-md border border-border bg-surface-raised p-4">
				<header>
					<div class="flex flex-wrap items-center gap-2">
						<h2 class="font-semibold">{= project.name }</h2>
						{#if active_page_set}
							<span class="pill-layout bg-neutral-200">{= active_page_set.name } ({= active_page_set.page_count } {_ labels.pages})</span>
						{/if}
						<span class="pill-layout bg-neutral-200">{_ labels.capture_size}: {= project.capture_size_label }</span>
						<span class="pill-layout text-xs font-bold {#if project.baseline_ready}pill-yes{:else}bg-neutral-200{/if}">
							{#if project.baseline_ready}{_ status.baseline_ready}{:else}{_ status.no_baseline}{/if}
						</span>
					</div>
					<a
						class="mt-1 block break-all text-xs font-semibold text-brand hover:underline"
						href="{= project.base_url }"
						target="_blank"
					>
						{= project.base_url }
					</a>
				</header>

				{#if !active_page_set}
					<app-banner type="blue">{_ ui.no_page_set}
						<a
							class="font-bold underline"
							href="{~ localized_path('/projects') }"
						>
							{_ actions.manage_page_sets}
						</a>
					</app-banner>
				{:else}
					<section class="rounded-md border border-border bg-surface p-4">
						<div class="flex flex-wrap items-center gap-2">
							<h3 class="font-semibold">{_ baseline.title}</h3>{#if project.baseline_ready}
								<span class="pill-layout bg-neutral-200">{= project.baseline.page_count } {_ labels.baseline_pages}</span>{/if}{#if project.baseline && project.baseline.has_db_snapshot}
								<span class="pill-layout bg-neutral-200">{_ labels.db_snapshot}</span>
						{/if}</div>
						<p class="mt-1 text-sm text-text-secondary">{_ baseline.description}</p>
						{#if project.baseline && project.baseline.db_snapshot_missing}
							<app-banner type="yellow">{_ ui.db_snapshot_missing}</app-banner>
						{/if}
						{#if project.baseline}
							<details class="group mt-3 rounded-md border border-border bg-surface-raised p-3">
								<summary class="flex cursor-pointer items-center gap-2 font-semibold marker:content-none">
									<span
										class="transition-transform group-open:rotate-90"
										aria-hidden="true"
									>
									❯</span>{_ labels.baseline_details}
								</summary>
								<div class="mt-3 grid gap-3 text-sm sm:grid-cols-2 lg:grid-cols-3">
									<div>
										<div class="text-xs font-semibold uppercase tracking-wider text-text-secondary">{_ labels.baseline_updated}</div>
										<div class="mt-1">{= project.baseline.captured_display }</div>
									</div>
									<div>
										<div class="text-xs font-semibold uppercase tracking-wider text-text-secondary">{_ labels.baseline_pages}</div>
										<div class="mt-1">{= project.baseline.page_count }</div>
									</div>
									<div>
										<div class="text-xs font-semibold uppercase tracking-wider text-text-secondary">{_ labels.latest_capture_pages}</div>
										<div class="mt-1">{= project.baseline.latest_capture_count }</div>
									</div>
									<div class="sm:col-span-2 lg:col-span-3">
										<div class="text-xs font-semibold uppercase tracking-wider text-text-secondary">{_ labels.baseline_url}</div>
										<a
											class="mt-1 block break-all font-semibold text-brand hover:underline"
											href="{= project.baseline.base_url }"
											target="_blank"
										>
											{= project.baseline.base_url }
										</a>
									</div>
								</div>
							</details>
						{/if}
						<form
							method="POST"
							action="{~ localized_path('/run-tests/capture') }"
							class="mt-4 flex flex-wrap items-end gap-2"
						>
							<input type="hidden" name="_csrf_token" value="{= csrf_token }" />
							<button
								type="submit"
								class="button primary"
								{#if busy}disabled{/if}
							>
								{_ baseline.capture}
							</button>
							<p class="text-sm text-text-secondary">{_ baseline.capture_hint}</p>
						</form>
					</section>

					<section class="rounded-md border border-border bg-surface p-4">
						<h3 class="font-semibold">{_ visual.title}</h3>
						<p class="mt-1 text-sm text-text-secondary">{_ visual.description}</p>
						<form
							method="POST"
							action="{~ localized_path('/run-tests/compare') }"
							class="mt-4 flex flex-wrap items-end gap-2"
						>
							<input type="hidden" name="_csrf_token" value="{= csrf_token }" />
							<button
								type="submit"
								class="button primary"
								{#if !project.baseline_ready || busy}disabled{/if}
							>
								{_ actions.compare}
							</button>
						</form>
						{#if !project.baseline_ready}
							<p class="mt-3 text-sm text-text-secondary">{_ visual.no_baseline_hint}</p>
						{/if}
					</section>

					<section
						class="grid gap-3"
						style="grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr))"
					>
						<div class="rounded-md border border-border bg-surface p-4">
							<div class="text-xs font-semibold uppercase tracking-wider text-text-secondary">{_ labels.chrome}</div>
							<div class="mt-1 font-semibold {#if capabilities.chrome}text-success{:else}text-brand{/if}">{= capabilities.chrome_message }</div>
						</div>
						<div class="rounded-md border border-border bg-surface p-4">
							<div class="text-xs font-semibold uppercase tracking-wider text-text-secondary">{_ labels.image_diff}</div>
							<div class="mt-1 font-semibold {#if capabilities.vips}text-success{:else}text-brand{/if}">{= capabilities.vips_message }</div>
						</div>
						<div class="rounded-md border border-border bg-surface p-4">
							<div class="text-xs font-semibold uppercase tracking-wider text-text-secondary">{_ labels.evidence_render}</div>
							<div class="mt-1 font-semibold {#if capabilities.ffmpeg}text-success{:else}text-brand{/if}">{= capabilities.ffmpeg_message }</div>
						</div>
						<div class="rounded-md border border-border bg-surface p-4">
							<div class="text-xs font-semibold uppercase tracking-wider text-text-secondary">{_ labels.voiceover}</div>
							<div class="mt-1 font-semibold {#if capabilities.say}text-success{:else}text-brand{/if}">{= capabilities.say_message }</div>
						</div>
					</section>
				{/if}
			</article>

			<section class="rounded-md border border-border bg-surface p-4">
				<div class="flex flex-wrap items-center gap-2">
					<h3 class="font-semibold">{_ schedule.title}</h3>{#if schedules.length > 0}
						<span class="pill-layout bg-neutral-200">{= schedules.length }</span>
				{/if}</div>
				<p class="mt-1 text-sm text-text-secondary">{_ schedule.description}</p>
				{#if schedules.length === 0}
					<p class="mt-2 text-sm text-text-secondary">{_ schedule.no_schedules}</p>
				{:else}
					<ol class="mt-3 list-none divide-y divide-border [&>li]:m-0">
						{#each schedules as schedule}
							<li class="flex flex-wrap items-center gap-2 py-2 text-sm">
								<span class="pill-layout bg-neutral-200">{= schedule.page_set_name }</span>
								<span class="pill-layout text-xs font-bold {#if schedule.operation === 'compare'}pill-yes{:else}bg-neutral-200{/if}">
									{#if schedule.operation === 'compare'}{_ actions.compare}{:else}{_ baseline.capture}{/if}
								</span>
								<span>{_ schedule.every} {= schedule.interval_hours } {_ schedule.hours}</span>
								{#if schedule.last_run_display}
									<span class="text-xs text-text-secondary">{_ schedule.last_run}: {= schedule.last_run_display }</span>
								{/if}
								<form method="POST" action="{~ localized_path('/run-tests/schedule/remove') }" class="ml-auto inline">
									<input type="hidden" name="_csrf_token" value="{= csrf_token }" />
									<input type="hidden" name="schedule_id" value="{= schedule.id }" />
									<button
										type="submit"
										class="button tertiary text-xs"
									>
										{_ schedule.remove}
									</button>
								</form>
							</li>
						{/each}
					</ol>
				{/if}
				{#if active_page_set}
					<form
						method="POST"
						action="{~ localized_path('/run-tests/schedule') }"
						class="mt-3 flex flex-wrap items-end gap-2"
					>
						<input type="hidden" name="_csrf_token" value="{= csrf_token }" />
						<label class="grid gap-1 text-sm font-semibold">{_ schedule.operation}
							<select name="operation">
								<option value="compare">{_ actions.compare}</option>
								<option value="baseline">{_ baseline.capture}</option>
							</select>
						</label>
						<label class="grid gap-1 text-sm font-semibold">{_ schedule.interval}
							<input
								name="interval_hours"
								type="number"
								min="1"
								max="8760"
								value="24"
								required
							/>
						</label>
						<button type="submit" class="button primary">{_ schedule.add}</button>
					</form>
				{/if}
			</section>

			<section class="space-y-3">
				<div class="flex flex-wrap items-center gap-3">
					<h2 class="font-semibold">{_ results.history_title}</h2>
					{#if results.length > 0}
						<confirm-dialog trigger-class="button primary text-xs" confirm-class="button danger" form-path="/run-tests/clear" title="{_ actions.clear}" trigger-text="{_ actions.clear}" message="{_ confirm.clear}" confirm-text="{_ actions.confirm_clear}" cancel-text="{_ actions.cancel}"></confirm-dialog>
					{/if}
				</div>
				<p class="text-sm text-text-secondary">{_ results.history_description}</p>
				{#if results.length === 0}
					<p class="text-sm text-text-secondary">{_ results.no_results}</p>
				{:else}
					<ol class="list-none divide-y divide-border bg-surface-raised shadow-lg [&>li]:m-0">
						{#each results as result}
							<li>
								<a
									href="{~ localized_path(`/results/visual/${result.id}`) }"
									class="grid gap-3 px-4 py-3 hover:bg-neutral-100 sm:grid-cols-[minmax(0,1fr)_8rem_11rem] sm:items-center"
								>
									<div class="min-w-0">
										<div class="font-semibold">{= result.project_name }</div>
										<div class="mt-1 truncate text-xs text-text-secondary">{= result.page_selection_label }: {= result.changed_count + result.new_count + result.removed_count } {_ labels.changed} · {= result.pages.length } {_ labels.pages}</div>
									</div>
									<div>
										<span class="pill-layout text-xs font-bold {= result.status_class }">{= result.status_label }</span>
										<div class="mt-1 text-xs text-text-secondary">{= result.duration_display }</div>
									</div>
									<div class="text-xs text-text-secondary">{= result.started_display }</div>
								</a>
							</li>
						{/each}
					</ol>
				{/if}
			</section>
		{/if}
	</div>
	<script src="/dialog-confirm.js?v={= version}"></script>
{/with}
