{#layout("dashboard/layout")}
{#with props}
	<div class="w-full py-4 space-y-4">
		<header class="px-4">
			<h1 class="text-xl font-bold">{_ ui.title}</h1>
			<p class="mt-1 text-sm text-text-secondary">{_ ui.description}</p>
			{#if reports.length > 0}
				<div class="mt-3 flex flex-wrap gap-2">
					<confirm-dialog trigger-class="button primary text-xs" confirm-class="button danger" form-path="/reports/clear" title="{_ actions.clear}" trigger-text="{_ actions.clear}" message="{_ confirm.clear}" confirm-text="{_ actions.confirm_remove}" cancel-text="{_ actions.cancel}"></confirm-dialog>
				</div>
			{/if}
		</header>
		{#if form_error}
			<div class="px-4">
				<app-banner type="red">{= props.form_error }</app-banner>
			</div>
		{/if}
		{#if reports.length === 0}
			<p class="px-4 text-sm text-text-secondary">{_ ui.no_reports}</p>
		{:else}
			<div
				class="grid w-full gap-x-4 bg-surface-raised shadow-lg"
				style="grid-template-columns: 12ch 1fr 12ch 12ch 18ch 12ch"
			>
				<div class="col-span-full grid grid-cols-subgrid bg-neutral-200 font-semibold *:px-2 *:py-2 sticky top-0">
					<div>{_ labels.status}</div>
					<div>{_ labels.project}</div>
					<div>{_ labels.changed}</div>
					<div>{_ labels.pages}</div>
					<div>{_ labels.started}</div>
					<div>{_ labels.actions}</div>
				</div>
				{#each reports as report}
					<div class="col-span-full grid grid-cols-subgrid items-center border-b border-neutral-200 *:px-2 *:py-2 hover:bg-neutral-100">
						<div>
							<span class="pill-layout text-xs font-bold {= report.status_class }">{= report.status_label }</span>
						</div>
						<div>
							<a
								href="{~ localized_path(`/reports/${report.id}`) }"
								class="font-semibold text-brand hover:underline"
							>
								{= report.project_name }
							</a>
						</div>
						<div>{= report.changed_count + report.new_count + report.removed_count }</div>
						<div>{= report.pages.length }</div>
						<div class="text-xs text-text-secondary">{= report.started_display }</div>
						<div>{#if report.status !== 'queued' && report.status !== 'running' && report.status !== 'canceling'}
								<confirm-dialog trigger-class="button tertiary text-xs" confirm-class="button danger" form-path="/reports/delete" title="{_ actions.delete}" trigger-text="{_ actions.delete}" message="{_ confirm.delete}" confirm-text="{_ actions.confirm_remove}" cancel-text="{_ actions.cancel}" extra-field-name="run_id" extra-field-value="{= report.id }"></confirm-dialog>
						{/if}</div>
					</div>
				{/each}
			</div>
		{/if}
	</div>
	<script src="/dialog-confirm.js?v={= version}"></script>
{/with}
