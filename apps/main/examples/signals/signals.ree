<!DOCTYPE html>
<html lang="en-us">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Signals</title>
		<link rel="stylesheet" href='/app{~ props.is_dev ? "-dev" :"" }.css?v={= props.version }' />

		<script type="module">
			// This is an example of Alien Deepsignals usage. It loads the library
			// from a CDN so the page is self-contained. To use deepsignals in your
			// own pages, run `bun get:signals` to vendor it into static/, then import
			// from "/alien-deepsignals.min.js" instead of the CDN (no runtime CDN).
			import { deepSignal, watchEffect } from "https://esm.sh/alien-deepsignals@0.4.2";
			import { bind_state } from "/state-bind.js";

			// Single reactive state, bound declaratively via [data-bind] / [data-key]
			const app_state = deepSignal({
				counter: parseInt(counter_input.value, 10),
				profile: {
					first_name: first_name_input.value,
					last_name: last_name_input.value,
				},
			});

			bind_state(app_state, watchEffect);

			plus_button.onclick = () => app_state.counter++;
		</script>
	</head>

	<body class="mx-auto flex max-w-[60ch] flex-col gap-4 p-4">
		<h1>Signals demo</h1>

		<h2 class="text-brand">This page is intentionally not translated and without layout.</h2>

		<a href="/" class="text-primary w-fit underline">Go back home</a>

		<div class="mt-4 flex flex-col gap-2">
			<h3 class="text-lg font-medium">Counter</h3>
			<form id="counter_form" class="flex items-center gap-2">
				<input id="counter_input" name="counter" data-bind="counter" type="number" value="100" disabled />
				<button type="button" id="plus_button" class="button primary">Add 1</button>
			</form>
		</div>

		<div class="mt-4 flex flex-col gap-2">
			<h3 class="text-lg font-medium">Profile</h3>
			<form id="profile_form" class="flex gap-2">
				<input id="first_name_input" name="first_name" data-bind="profile.first_name" value="Aleš" />
				<input id="last_name_input" name="last_name" data-bind="profile.last_name" value="Vaupotič" />
			</form>
		</div>

		<div class="mt-4 flex flex-col gap-2">
			<h3 class="text-lg font-medium">Current state</h3>
			<dl class="bg-surface-sunken grid grid-cols-[max-content_1fr] gap-x-4 gap-y-1 rounded-md p-4 text-sm">
				<dt class="text-surface-dim">counter</dt>
				<dd data-key="counter"></dd>
				<dt class="text-surface-dim">profile.first_name</dt>
				<dd data-key="profile.first_name"></dd>
				<dt class="text-surface-dim">profile.last_name</dt>
				<dd data-key="profile.last_name"></dd>
			</dl>
		</div>
	</body>
</html>
