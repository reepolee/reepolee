{#layout("layout") }
{#with props}

	<!--
		AGENT GUIDE: This template intentionally follows the generated CRUD index
		shape, but it receives rows from a local/non-table source. The handler owns
		data loading, filtering, sorting, and pagination; this file owns markup.
	-->
	<div class="py-4">
		<!-- LIST TOOLBAR: shared pagination, page-size, sort, search, and filters. -->
		<div class="flex items-center gap-1 justify-between w-full flex-wrap px-4">
			<!-- AGENT EXTENSION POINT: Keep pagination URLs generated in TypeScript;
			     only change the controls here when changing the visual layout. -->
			<div class="pagination-info">
				{#if first_url }
					<a href="{~ localized_path(first_url) }" role="button" aria-label="First page"><ree-icon name="chevrons_left"></ree-icon></a>
				{:else }
					<ree-icon name="chevrons_left"></ree-icon>
				{/if}
				{#if prev_url }
					<a href="{~ localized_path(prev_url) }" role="button" aria-label="Previous page"><ree-icon name="chevron_left"></ree-icon></a>
				{:else }
					<ree-icon name="chevron_left"></ree-icon>
				{/if}
				{#if total > 0 }
					<div style="width: {= total.toString().length * 3 + 4 }ch; text-align: center">{= offset + 1 }-{= Math.min(offset + (limit === 'all' ? total : limit), total) } / {= total}</div>
				{:else }
					<div style="width: 7ch; text-align: center">0 / 0</div>
				{/if}
				{#if next_url }
					<a href="{~ localized_path(next_url) }" role="button" aria-label="Next page"><ree-icon name="chevron_right"></ree-icon></a>
				{:else }
					<ree-icon name="chevron_right"></ree-icon>
				{/if}
				{#if last_url }
					<a href="{~ localized_path(last_url) }" role="button" aria-label="Last page"><ree-icon name="chevrons_right"></ree-icon></a>
				{:else }
					<ree-icon name="chevrons_right"></ree-icon>
				{/if}
			</div>

			<!-- `navigate_to` is provided by /helpers-client.js and resets offset when
			     the page size changes. -->
			<div class="flex items-center gap-2">
				<select id="limit" class="w-[20ch]" onchange="navigate_to('limit', this.value)">
					{#each limit_options as option }
						<option value="{= option }" {#if option === limit }selected{/if}>
							{#if option === "all"}{_ selectors.all}{:else}{= option } {_ selectors.per_page}{/if}
						</option>
					{/each}
				</select>
			</div>

			<!-- Sort values must match SORT_OPTIONS in index.ts. Add the option there
			     before adding a new selector value here. -->
			<div class="flex items-center gap-2">
				<select id="order_by" class="w-[32ch]" onchange="navigate_to('order_by', this.value)">
					{#each sort_options as option }
						<option value="{= option.value }" {#if option.value === order_by }selected{/if}>{= option.field } ({= option.direction })</option>
					{/each}
				</select>
			</div>

			<!-- The shared filter component renders Owner and Status selections from
			     the enriched filter_definitions passed by the handler. It does not know
			     about SQL; both selections are applied to the local array in index.ts. -->
			<ree-filters action-url="/examples/index-template" query="{= query }" limit="{= limit }" order_by="{= order_by }"></ree-filters>
		</div>

		<!-- TABLE BODY: add/remove columns in the header and row together. Every
		     row is an anchor so clicking anywhere opens the detail/edit example. -->
		{#if records.length === 0 }
			<p class="p-4">{_ ui.no_records}</p>
		{:else }
			<!-- AGENT EXTENSION POINT: Update these tracks when adding/removing
			     columns. The header and each row must keep the same column count. -->
			<div class="grid gap-x-4 w-full bg-surface-raised shadow-lg mt-4 overflow-x-auto" style="grid-template-columns: 10ch 14ch minmax(28ch, 1fr) 12ch 18ch 18ch">
				<!-- Header cells mirror the row cells below. -->
				<div class="col-span-full grid grid-cols-subgrid bg-neutral-200 font-semibold *:px-2 *:py-2 sticky top-0">
					<div>{_ labels.id}</div>
					<div>{_ labels.method}</div>
					<div>{_ labels.path}</div>
					<div>{_ labels.status}</div>
					<div>{_ labels.owner}</div>
					<div>{_ labels.last_checked}</div>
				</div>

				<!-- `record.owner` is a display-only mapping added by the handler;
				     the source value remains `record.owner_id`. -->
				{#each records as record }
					<!-- AGENT EXTENSION POINT: Change this URL when replacing the detail
					     route. Keep record.id (or your equivalent stable key) in the link. -->
					<a href="{~ localized_path('/examples/index-template/' + record.id + '/record-details') }" class="col-span-full *:py-2 grid grid-cols-subgrid border-b border-b-neutral-200 *:px-2 hover:bg-primary hover:text-white transition-colors">
						<div class="font-mono text-sm">{= record.id }</div>
						<div><span class="rounded bg-slate-200 px-2 py-1 text-xs font-semibold text-slate-700">{= record.method }</span></div>
						<div class="font-mono text-sm">{= record.path }</div>
						<div><span class="rounded px-2 py-1 text-xs font-semibold {= record.status >= 400 ? 'bg-red-100 text-red-700' : (record.status >= 300 ? 'bg-amber-100 text-amber-700' : 'bg-green-100 text-green-700') }">{= record.status }</span></div>
						<div>{= record.owner }</div>
						<div>{~ js_date_to_locale_string(record.last_checked) }</div>
					</a>
				{/each}
			</div>
		{/if}
	</div>
{/with}
