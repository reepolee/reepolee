<!DOCTYPE html>
<html lang="{= format_bcp47(props.locale) }" class="{= props.theme_class }">

	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />

		<link rel="stylesheet" href='/app{~ props.is_dev ? "-dev" :"" }.css?v={= props.version }' />
		<title>{= props.translations?.ui?.title || props.site_name}</title>

		<script src="/helpers-client.js?v={= props.version }"></script>
		<script src="/web-components/validation-error.js?v={= props.version }"></script>
		<script src="/web-components/toasts-area.js?v={= props.version }"></script>
		<script src="/web-components/markdown-editor.js?v={= props.version }"></script>
		<script src="/web-components/date-input.js?v={= props.version }"></script>
		<!-- <script src="/dpu.min.js?v={= props.version }" defer></script> -->

		{#if (!props.is_dev)}
			<!-- {#include('speculationrules.partial')} -->
		{/if}
		<meta http-equiv="Content-Language" content="{= format_bcp47(props.locale) }" />

		<!-- Presentation boundaries: conventional BCP 47 casing for search/OG metadata.
		     hreflang hrefs are absolute when a request origin is available, relative otherwise. -->
		{#if props.request_url}
			<link rel="alternate" hreflang="x-default" href="{~ `${props.request_origin}${localized_path_for_locale(props.default_locale, props.request_url)}` }" />
			{#each props.active_locales as alt_locale}
				<link rel="alternate" hreflang="{= format_bcp47(alt_locale) }" href="{~ `${props.request_origin}${localized_path_for_locale(alt_locale, props.request_url)}` }" />
			{/each}
		{/if}
		<meta property="og:locale" content="{= format_og_locale(props.locale) }" />
		{#each props.active_locales as alt_locale}
			{#if alt_locale !== props.locale}
				<meta property="og:locale:alternate" content="{= format_og_locale(alt_locale) }" />
			{/if}
		{/each}
	</head>

	<body class="bg-surface grid grid-cols-[30ch_1fr] min-h-screen">

		{#if props.path_locale && props.locale_preferred && props.path_locale !== props.locale_preferred}
			<!-- LANG MISMATCH DIALOG START -->
			<dialog id="lang_mismatch_dialog" class="p-0 rounded-xl shadow-2xl min-w-100">
				<div class="p-6">
					<h2 class="text-lg font-semibold">{_ ui.lang_mismatch_title}</h2>
					<p class="text-slate-600 mt-2">
						{_ ui.lang_mismatch_body}
						<strong>{= props.path_locale_name}</strong>
					</p>
					<div class="mt-6 flex justify-end gap-2">
						<form method="dialog">
							<button class="px-3 py-1 rounded bg-slate-200" value="dismiss">{_ actions.lang_mismatch_dismiss}</button>
						</form>
						<a href="?locale={= props.locale_preferred }" class="px-3 py-1 rounded bg-brand text-white no-underline">{_ actions.lang_mismatch_switch}</a>
					</div>
				</div>
			</dialog>
			<script>
				document.getElementById("lang_mismatch_dialog")?.showModal();
			</script>
			<!-- LANG MISMATCH DIALOG END -->
		{/if}

		<nav class="flex py-4 bg-neutral-200 gap-4 pb-8 flex-col border-r border-r-neutral-300 justify-between h-screen sticky top-0 overflow-y-auto max-xl:hidden">

			<div class="top flex flex-col">
				<div class="flex items-center justify-between gap-2 px-4 mb-4">
					<a href="/">
						<img class="w-24" src="{= props.dark_mode ? '/logo-light.svg' : '/logo-dark.svg' }" alt="Reepolee logo" />
					</a>
					<app-switcher></app-switcher>
				</div>

				{#if props.reeqa_project_selector}
					<form method="POST" action="{~ localized_path(props.reeqa_project_selector.action) }" class="px-4 mb-6">
						<input type="hidden" name="_csrf_token" value="{= csrf_token }" />
						<input type="hidden" name="next" value="{= props.reeqa_project_selector.next }" />
						<label class="grid gap-1 text-xs font-semibold uppercase tracking-wider text-text-secondary">
							<span class="ml-3">{= props.reeqa_project_selector.label }</span>
							<select name="project_id" class="text-base w-full" onchange="this.form.submit()">
								{#each props.reeqa_project_selector.projects as project}
									<option value="{= project.id }" {#if project.id === props.reeqa_project_selector.active_project_id}selected{/if}>{= project.name }</option>
								{/each}
							</select>
						</label>
					</form>
				{/if}

				{#if props.reeqa_page_set_selector}
					<form method="POST" action="{~ localized_path(props.reeqa_page_set_selector.action) }" class="px-4 mb-6">
						<input type="hidden" name="_csrf_token" value="{= csrf_token }" />
						<input type="hidden" name="next" value="{= props.reeqa_page_set_selector.next }" />
						<label class="grid gap-1 text-xs font-semibold uppercase tracking-wider text-text-secondary">
							<span class="ml-3">{= props.reeqa_page_set_selector.label }</span>
							<select name="page_set_id" class="text-base w-full" onchange="this.form.submit()">
								{#each props.reeqa_page_set_selector.page_sets as page_set}
									<option value="{= page_set.id }" {#if page_set.id === props.reeqa_page_set_selector.active_page_set_id}selected{/if}>{= page_set.name } ({= page_set.page_count }) · {= page_set.capture_width }px</option>
								{/each}
							</select>
						</label>
					</form>
				{/if}

				<!-- NAVIGATION START -->

				{#each props.nav_groups as group}
					{#if !group.label || user_has_module(props.user, group.label)}
						{#if group.label}
							<details class="group mb-8" data-nav-module="{= group.label }" {#if !props.collapsed_nav_modules.includes(group.label) }open{/if}>
								<summary class="flex cursor-pointer items-center px-4 text-xs font-semibold uppercase tracking-wider text-brand marker:content-none">
									<span class="mr-2 transition-transform group-open:rotate-90">❯</span>
									{= props.translations.nav_prefix_title?.[group.label]}
								</summary>
								<div class="mt-2 flex flex-col">
									{#each group.items as entry}
										<a href="{~ localized_path(entry.url) }" class="{= is_current(localized_path(entry.url)) } pl-6 hover:bg-neutral-100">{= nav_label(entry.nav_title_key)}</a>
										{#if entry.nav_rule_after}
											<hr class="mx-4 my-4 border-neutral-300" />
										{/if}
									{/each}
								</div>
							</details>
						{:else}
							{#each group.items as entry}
								{#if user_has_module(props.user, entry.required_module)}
									<a href="{~ localized_path(entry.url) }" class="{= is_current(localized_path(entry.url)) } pl-6 hover:bg-neutral-100">{= nav_label(entry.nav_title_key)}</a>
									{#if entry.nav_rule_after}
										<hr class="mx-4 my-4 border-neutral-300" />
									{/if}
								{/if}
							{/each}
							<div class="mb-8"></div>
						{/if}

					{/if}
				{/each}

				<!-- NAVIGATION END -->

			</div>

			<div class="bottom flex flex-col gap-2 px-4">
				<div class="flex items-center gap-2">
					{#if props.active_locales.length <= 5}
						<div class="flex flex-wrap items-center gap-1" aria-label="Language">
							{#each props.active_locales as locale}
								{#if props.locale === locale}
									<span aria-current="true" class="text-xs px-2 py-1 font-bold" title="{= props.locale_names?.[locale] || locale }">{= locale_short_code(locale) }</span>
								{:else}
									<a href="?locale={= locale }" class="text-xs px-2 py-1 rounded border border-transparent no-underline hover:border-neutral-300 hover:bg-neutral-100" title="{= props.locale_names?.[locale] || locale }">{= locale_short_code(locale) }</a>
								{/if}
							{/each}
						</div>
					{:else}
						<select aria-label="Language" onchange="location.href=this.value" class="text-base w-36 px-2 py-1">
							{#each props.active_locales as locale}
								<option value="?locale={= locale }" {#if props.locale === locale}selected{/if}>{= props.locale_names?.[locale] || locale}</option>
							{/each}
						</select>
					{/if}
					<button id="theme-toggle" aria-label="Toggle dark mode" class="ml-auto cursor-pointer px-2 py-1 text-xs rounded border border-transparent hover:border-neutral-300 hover:bg-neutral-100">🌙</button>
				</div>
				<div class="flex items-center gap-2 font-semibold pl-2" title="{= Bun.env.DEV_CONNECTION_STRING || '' }">
					{#if props.user}
						<a href="{~ localized_path('/profile') }">{= props.user.display_name}</a>
					{:else}
						<a href="{~ localized_path('/login') }">{_ nav_auth.login}</a>
					{/if}
				</div>

			</div>

		</nav>

		<main id="main" class="max-xl:min-w-screen">{~ props.body}</main>

		<toasts-area id="toasts-area">
			<!-- TOASTS (server-rendered, no JS required) -->
			{#each props.toasts as toast}
				{{
					const toast_classes = new Map([
						['green', 'bg-green-600/90 text-white'],
						['red', 'bg-brand/90 text-white'],
						['yellow', 'bg-amber-300/90 text-black'],
					]);
					const toast_class = toast_classes.get(toast.type) ?? 'bg-white text-black border border-neutral-300';
				}}
				<div id="toast-{= toast.key }"
					class="animate-in-top"
					style="--toast-duration:{= toast.duration ?? 3000 }ms">

					<div class="relative px-3 py-2 mb-3 {= toast_class }	font-semibold rounded-sm min-w-96 pointer-events-auto">

						<div class="pr-6">
							{= toast.message } {~ toast.user ? `(${toast.user})` : "" }
						</div>

						<a href="#toast-{= toast.key }" class="absolute top-1 right-1 h-8 w-8 flex items-center justify-center text-lg leading-none opacity-70 hover:opacity-100 hover:bg-black/10 rounded-full no-underline" aria-label="Close toast">
							🗙
						</a>

					</div>
				</div>
			{/each}
		</toasts-area>
		{#if is_dev}
			<script src="/web-components/tailwind-size.js?v={= props.version }"></script>
			<tailwind-size-toggle></tailwind-size-toggle>
			<script>
				console.info({~ props.toJSON});
				window.addEventListener("pageshow", (event) => {
					if (event.persisted) {
						console.log("Page restored from BFCache");
					} else {
						console.log("Normal page load");
					}
				});
				const nav = performance.getEntriesByType("navigation")[0];
				console.log("navigation type:", nav?.type);
			</script>
		{/if}

		<!-- Auto-refresh busy pages once the in-flight reeman action completes. Only
		     apps that serve /__busy (reeman, reeqa) render this - the main app's
		     generated/public pages have no such route, so polling it would 404. -->
		{#if props.busy_poller}
			<busy-poller></busy-poller>
		{/if}
	</body>

	<script>
		init_theme_toggle();

		const nav_module_details = document.querySelectorAll("details[data-nav-module]");
		for (const nav_module_detail of nav_module_details) {
			nav_module_detail.addEventListener("toggle", () => {
				const collapsed_modules = Array.from(document.querySelectorAll("details[data-nav-module]:not([open])"), (element) => element.dataset.navModule);
				const cookie_value = encodeURIComponent(JSON.stringify(collapsed_modules));
				document.cookie = `nav_collapsed_modules=${cookie_value}; path=/; max-age=31536000; samesite=lax`;
			});
		}
	</script>

</html>
