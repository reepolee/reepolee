{#layout("layout")}
{#with props}
	<div class="w-full p-4 space-y-6">

		<header class="flex flex-wrap items-center justify-between gap-3">
			<div>
				<h1 class="text-xl font-bold">{_ ui.project_title}</h1>
				<p class="text-sm text-text-secondary mt-1">{_ ui.project_description}</p>
			</div>
		</header>

		{#if form_error}
			<app-banner type="red">{= form_error}</app-banner>
		{/if}

		<section class="grid reeman-card-grid gap-4">

			<form method="POST" action="{~ localized_path('/project/set-repos') }" class="flex flex-col gap-3 rounded-md border border-border bg-surface-raised p-4">
				<input type="hidden" name="_csrf_token" value="{= csrf_token }" />
				<h2 class="font-semibold">{_ actions.set_repos}</h2>
				<p class="text-sm text-text-secondary">{_ ui.set_repos_hint}</p>

				<field-wrapper class="grid" data-field="owner_repos">
					<div class="grid">
						<label class="px-3" for="owner-repos">{_ labels.owner_repos}</label>
						<textarea id="owner-repos" name="owner_repos" rows="5" class="font-mono" spellcheck="false" autocomplete="off" required>{= current_repos.join('\n')}</textarea>
						<validation-error class="mt-1" id="error-owner_repos"></validation-error>
					</div>
				</field-wrapper>

				<button type="submit" class="as-button-primary mt-auto">{_ actions.save_repos}</button>
			</form>
		</section>
	</div>
{/with}
