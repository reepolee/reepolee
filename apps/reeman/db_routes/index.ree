{#layout("layout") }
{#with props}

	<div class="py-4">

		{#if busy}
			<div class="px-4 mb-4">
				<app-banner type="yellow">{_ ui.busy}{#if busy.target}: <code>{= busy.target }</code>{/if}</app-banner>
			</div>
		{/if}

		<!-- TABLE DISPLAY CONTROLLER -->
		<div class="flex items-center gap-1 justify-between w-full flex-wrap px-4">

			<div class="pagination-info">
				{#if first_url }
					<a href="{~ localized_path(first_url) }" role="button" class="as-button">
						<ree-icon name="chevrons_left"></ree-icon>
					</a>
				{:else }
					<ree-icon name="chevrons_left"></ree-icon>
				{/if}

				{#if prev_url }
					<a href="{~ localized_path(prev_url) }" role="button" class="as-button"><ree-icon name="chevron_left"></ree-icon></a>
				{:else }
					<ree-icon name="chevron_left"></ree-icon>
				{/if}

				{#if total > 0 }
					<div style="width: {= total.toString().length * 3 + 4 }ch; text-align: center">{= offset + 1 }-{= Math.min(offset + (limit === 'all' ? total : limit), total) } / {= total}</div>
				{:else }
					<div style="width: 7ch; text-align: center">0 / 0</div>
				{/if}

				{#if next_url }
					<a href="{~ localized_path(next_url) }" role="button" class="as-button">
						<ree-icon name="chevron_right"></ree-icon>
					</a>
				{:else }
					<ree-icon name="chevron_right"></ree-icon>
				{/if}

				{#if last_url }
					<a href="{~ localized_path(last_url) }" role="button" class="as-button">
						<ree-icon name="chevrons_right"></ree-icon>
					</a>
				{:else }
					<ree-icon name="chevrons_right"></ree-icon>
				{/if}
			</div>

			<div class="flex items-center gap-2">
				<select id="limit" class="w-[20ch]" onchange="navigate_to('limit', this.value)">
					{#each limit_options as option }
						<option value="{= option }" {#if option === limit }selected{/if}>
							{#if option==="all"}
								{_ selectors.all}
							{:else}
								{= option } {_ selectors.per_page}
							{/if}
						</option>
					{/each}
				</select>
			</div>

			<div class="flex items-center gap-2">
				<select id="order_by" class="w-[40ch]" onchange="navigate_to('order_by', this.value)">
					{#each sort_options as option }
						<option value="{= option.value }" {#if option.value === order_by }selected{/if}>{= props.translations.labels?.[option.field] || option.field } ({= option.direction === 'asc' ? props.translations.selectors.ascending : props.translations.selectors.descending })</option>
					{/each}
				</select>
			</div>

			<!-- ADD ROUTE ACTIONS (mirror the `bun reeman` CLI simple page flows) -->
			<a href="{~ localized_path('/routes/add-page') }" role="button" class="as-button-primary">
				+
				{_ actions.add_page }
			</a>
			<a href="{~ localized_path('/routes/add-table-page') }" role="button" class="as-button-primary">
				+
				{_ actions.add_table_page }
			</a>

			<ree-filters action-url="/routes"></ree-filters>

			{#if enable_archive }
				<!-- BULK ACTIONS -->
				<div class="flex items-center gap-4 justify-start w-full flex-wrap px-4 my-4">
					<button id="action" commandfor="refresh_dialog" command="show-modal" disabled class="as-button-primary">{_ actions.refresh_crud}</button>
					<button id="action_2" commandfor="remove_dialog" command="show-modal" disabled class="as-button-tertiary">{_ actions.remove_route}</button>
				</div>
			{/if}

		</div>

		<!-- TABLE GRID -->

		{#if (records.length === 0) }
			<p class="p-4">{_ ui.no_records}</p>

		{:else }

			<div class="grid gap-x-4 w-full bg-surface-raised shadow-lg mt-4" style="grid-template-columns: {= grid_cols }">

				<div class="col-span-full grid grid-cols-subgrid bg-neutral-200 font-semibold *:px-2 *:py-2 sticky top-0">
					{#if enable_archive }
						<div class="grid grid-cols-2 place-items-center p-0!">
							<button id="deselect_all" class="text-brand cursor-pointer"><ree-icon name="x" class="size-6"></ree-icon></button>
							<label class="w-full h-full grid place-items-center hover:bg-brand rounded">
								<input type="checkbox" name="select_all" id="select_all">
							</label>
						</div>
					{/if}
					<!-- GEN:FIELDS:HEADERS:START -->
					<div class="{= columns.url.class }">{_ labels.url }</div>
					<div class="{= columns.table_name.class }">{_ labels.table_name }</div>
					<div class="{= columns.module.class }">{_ labels.module }</div>
					<div class="{= columns.removable.class }">{_ labels.removable }</div>
					<div class="{= columns.template_hash_status.class }">{_ labels.template_hash_status }</div>
					<!-- GEN:FIELDS:HEADERS:END -->
					<!-- filler cell for the trailing grid_filler track in grid_cols -->
					<div class="grid-filler"></div>
				</div>
				{#each records as record }
					<a href="{~ localized_path(record.edit_path) }" class="col-span-full *:py-2 grid cursor-pointer grid-cols-subgrid border-b border-b-neutral-200 *:px-2 hover:bg-primary hover:text-white">

						{#if enable_archive }
							<div class="grid grid-cols-2 place-items-center p-0! m-0!">
								<div></div>
								<label class="w-full h-full grid place-items-center hover:bg-brand rounded" onclick="event.stopPropagation()">
									<input type="checkbox" name="checkboxes[]" value="{= record.url}" onclick="event.stopPropagation()">
								</label>
							</div>
						{/if}

						<!-- GEN:FIELDS:CELLS:START -->
						<div class="{= props.columns.url.class }">{= record.url }</div>
						<div class="{= props.columns.table_name.class }">{= record.table_name }</div>
						<div class="{= props.columns.module.class }">{= record.module }</div>
						<div class="{= props.columns.removable.class }">{~ yes_no(record.removable) }</div>
						<div class="{= props.columns.template_hash_status.class }">
							{#if record.template_hash_status === "modified"}
								<span class="pill-layout bg-red-700 text-white">{_ selectors.modified}</span>
							{/if}
							{#if record.template_hash_status === "untracked"}
								<span class="pill-layout bg-yellow-500 text-black">{_ selectors.untracked}</span>
							{/if}
							{#if record.template_hash_status === "clean"}
								<span class="pill-layout bg-green-700 text-white">{_ selectors.clean}</span>
							{/if}
						</div>
						<!-- GEN:FIELDS:CELLS:END -->
						<!-- filler cell for the trailing grid_filler track in grid_cols -->
						<div class="grid-filler"></div>
					</a>
				{/each}

			</div>
		{/if}

		{#if enable_archive }
			<!-- REFRESH CRUD DIALOG -->
			<dialog id="refresh_dialog" class="p-0 rounded-xl shadow-2xl w-120">
				<form method="POST" action="{~ localized_path('/routes/bulk-refresh') }" id="refresh_form" class="p-6">
					<input type="hidden" name="_csrf_token" value="{= csrf_token }" />
					<input type="hidden" name="return_to" value="/routes" />
					<h2 class="text-lg font-semibold">{_ actions.refresh_crud}</h2>
					<p class="text-slate-600 mt-2">{_ ui.modifying} <span class="font-semibold text-brand" id="refresh_count">0</span> {_ ui.records}.</p>
					<div class="mt-6 flex justify-end gap-2">
						<button type="button" class="as-button-secondary" commandfor="refresh_dialog" command="close">{_ actions.cancel}</button>
						<button type="submit" class="as-button-primary">{_ actions.do_it}</button>
					</div>
				</form>
			</dialog>

			<!-- REMOVE ROUTE DIALOG -->
			<dialog id="remove_dialog" class="p-0 rounded-xl shadow-2xl w-120">
				<form method="POST" action="{~ localized_path('/routes/bulk-remove') }" id="remove_form" class="p-6">
					<input type="hidden" name="_csrf_token" value="{= csrf_token }" />
					<input type="hidden" name="return_to" value="/routes" />
					<h2 class="text-lg font-semibold">{_ actions.remove_route}</h2>
					<p class="text-slate-600 mt-2">{_ ui.modifying} <span class="font-semibold text-brand" id="remove_count">0</span> {_ ui.records}. {_ ui.remove_route_hint}</p>
					<div class="mt-6 flex justify-end gap-2">
						<button type="button" class="as-button-secondary" commandfor="remove_dialog" command="close">{_ actions.cancel}</button>
						<button type="submit" class="as-button-danger">{_ actions.do_it}</button>
					</div>
				</form>
			</dialog>

			<script src="/checkbox-group.js?v={= version}"></script>
			<script src="/dialog-confirm.js?v={= version}"></script>
			<script>
				const bulkCheckboxes = document.getElementById("select_all")
					? new CheckboxGroup({ buttonSelectors: ["#action", "#action_2"] })
					: null;

				// Inject one hidden "urls" input per checked checkbox into a dialog's
				// form right before submit - the reeman action handlers read
				// params.getAll("urls").
				function inject_selected_urls(form) {
					form.querySelectorAll('input[name="urls"]').forEach((el) => el.remove());
					const selected = $$('input[name="checkboxes[]"]:checked');
					for (const cb of selected) {
						const hidden = document.createElement("input");
						hidden.type = "hidden";
						hidden.name = "urls";
						hidden.value = cb.value;
						form.appendChild(hidden);
					}
				}

				for (const form_id of ["refresh_form", "remove_form"]) {
					document.getElementById(form_id).addEventListener("submit", (e) => {
						inject_selected_urls(e.currentTarget);
					});
				}

				document.addEventListener("change", (e) => {
					if (e.target.name === "select_all" || e.target.name === "checkboxes[]") {
						const selected = $$('input[name="checkboxes[]"]:checked').length;
						for (const id of ["refresh_count", "remove_count"]) {
							document.getElementById(id).textContent = selected;
						}
					}
				});
			</script>
		{/if}
	</div>
{/with}
