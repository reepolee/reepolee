{#layout("layout") }

{#with props}
	<div class="p-4">

		<div class="flex items-center justify-between">
			<h1 class="mb-4">{#if record.id}{_ ui.edit_title }{:else}{_ ui.new_title }{/if}</h1>
			<div class="text-sm">{~ js_timestamp_to_locale_string(record.updated_at ?? record.created_at)}</div>
		</div>

		{#if form_errors}
			<div class="py-4">
				<app-banner type="red">{= props.form_errors }</app-banner>
			</div>
		{/if}

		<form method="POST" action="{~ localized_path(action) }" class="grid grid-cols-1 gap-4 max-w-[60ch]" id="entry-form">

			<!-- CSRF token -->
			<input type="hidden" name="_csrf_token" value="{= csrf_token }" />

			<!-- GEN:FIELDS:START -->
			<field-wrapper class="grid" data-field="name">
				<div class="grid">
					<label class="px-3" for="name">{_ labels.name}</label>
					<input type="text" id="name" name="name" value="{= record.name}" />
					<validation-error class="mt-1" id="error-name"></validation-error>
				</div>
				<p class="text-xs text-neutral-500 px-3 mt-1 lg:mt-0 lg:self-center"><!-- hints.name --></p>
			</field-wrapper>


			<field-wrapper class="grid" data-field="column_count">
				<div class="grid">
					<label class="px-3" for="column_count">{_ labels.column_count}</label>
					<input type="number" id="column_count" name="column_count" value="{= record.column_count}" />
					<validation-error class="mt-1" id="error-column_count"></validation-error>
				</div>
				<p class="text-xs text-neutral-500 px-3 mt-1 lg:mt-0 lg:self-center"><!-- hints.column_count --></p>
			</field-wrapper>


			<field-wrapper class="grid" data-field="fk_count">
				<div class="grid">
					<label class="px-3" for="fk_count">{_ labels.fk_count}</label>
					<input type="number" id="fk_count" name="fk_count" value="{= record.fk_count}" />
					<validation-error class="mt-1" id="error-fk_count"></validation-error>
				</div>
				<p class="text-xs text-neutral-500 px-3 mt-1 lg:mt-0 lg:self-center"><!-- hints.fk_count --></p>
			</field-wrapper>


			<field-wrapper class="grid" data-field="has_crud">
				<div class="grid">
					<label class="px-3" for="has_crud">{_ labels.has_crud}</label>
					<select id="has_crud" name="has_crud" value="{= record.has_crud}" class="w-[20ch]">
						<option value="-1">{_ selectors.select }</option>
						<option value="0" {#if String(record.has_crud) === "0" }selected{/if}>{_ selectors["0"] }</option>
						<option value="1" {#if String(record.has_crud) === "1" }selected{/if}>{_ selectors["1"]}</option>
					</select>
					<validation-error class="mt-1" id="error-has_crud"></validation-error>
				</div>
				<p class="text-xs text-neutral-500 px-3 mt-1 lg:mt-0 lg:self-center"><!-- hints.has_crud --></p>
			</field-wrapper>

			<!-- GEN:FIELDS:END -->

			<!-- Store referrer URL as hidden field -->
			<input type="hidden" id="return_url" name="_return_url" value="" />

			<!-- Save action: hidden field set by onclick on save buttons -->
			<input type="hidden" name="_save_action" id="save_action" value="" />

			<div class="flex gap-2 mt-8 items-center">
				<button id="btn-submit" type="submit" onclick="document.getElementById('save_action').value='stay'" class="as-button-primary">{_ actions.save }</button>
				<button id="btn-save-close" type="submit" onclick="document.getElementById('save_action').value='close'" class="as-button-secondary">{_ actions.save_close }</button>
				<button id="btn-cancel" type="button" onclick="history.back()" class="as-button-secondary">{_ actions.cancel}</button>

				{#if (record.id) && enable_archive }
					<button id="action_delete" type="button" command="show-modal" commandfor="action_delete_dialog" class="ml-auto as-button-tertiary">{_ actions.delete}</button>
				{/if}
			</div>
		</form>

		{#if (record.id) && enable_archive }
			<form id="delete-form" method="POST" action="{~ localized_path('/tables/' + record.id + '/edit') }" style="display: none;">
				<input type="hidden" name="_csrf_token" value="{= csrf_token }" />
				<input type="hidden" name="_action" value="delete" />
			</form>
		{/if}

	</div>

	{#if enable_archive }
		<dialog id="action_delete_dialog" class="p-0 rounded-xl shadow-2xl w-100">
			<div class="p-6">
				<h2 class="text-lg font-semibold">{_ actions.delete}</h2>
				<div class="mt-6 flex justify-end gap-2">
					<button class="as-button-secondary" type="button" commandfor="action_delete_dialog" command="close">{_ actions.abort_delete}</button>
					<button class="as-button-danger" type="button" command="--confirm" commandfor="action_delete_dialog">{_ actions.confirm_delete}</button>
				</div>
			</div>
		</dialog>
	{/if}
	<script src="/dialog-confirm.js?v={= version}"></script>
	<script src="/form-controller.js?v={= version}" defer></script>


	<script>
		const return_url_field = $("#return_url");
		if (return_url_field && document.referrer) {
			try {
				const referer_url = new URL(document.referrer);
				return_url_field.value = referer_url.pathname + referer_url.search;
			} catch (e) {}
		}
		
		{#if enable_archive }
		$("#action_delete_dialog").addEventListener("command", (e) => {
			if (e.command !== "--confirm") return;
			e.currentTarget.close();
			$("#delete-form").submit();
		});
		{/if}
		document.addEventListener("DOMContentLoaded", () =>{
			new FormController({
				form: "#entry-form",
				validate_url:
				"{~ localized_path('/tables/validate') }",
				submitted_text: "{- actions.submitted }",
			});
		});
	</script>
{/with}
