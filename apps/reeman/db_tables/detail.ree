{#layout("layout") }
{#with props}
	<div class="p-4">

		<div class="flex items-center justify-between">
			<h1 class="mb-4">{= table }</h1>
			<div class="flex items-center gap-2">
				<span class="pill-layout bg-neutral-200 font-semibold">{_ labels.row_count}: {= row_count }</span>
			</div>
		</div>

		<form method="POST" action="{~ localized_path('/crud') }" class="grid gap-4 max-w-[60ch] lg:max-w-[120ch] lg:grid-cols-2 lg:gap-x-6">
			<input type="hidden" name="_csrf_token" value="{= csrf_token }" />
			<input type="hidden" name="return_to" value="/routes" />
			<input type="hidden" name="table" value="{= table }" />

			<field-wrapper class="grid lg:col-span-2" data-field="grid_columns">
				<div class="grid">
					<label class="px-3">{_ labels.index_columns}</label>
					<div class="grid gap-x-2 rounded border border-border bg-surface-raised" style="grid-template-columns: minmax(0,1fr) 12ch minmax(0,1fr) minmax(0,35ch) auto">
						{#if grid_columns.length === 0}
							<p class="col-span-full p-3">{_ ui.no_selectable_columns}</p>
						{:else}
							<div class="col-span-full grid grid-cols-subgrid gap-2 px-3 py-2 font-semibold border-b border-border bg-surface">
								<span class="ml-10">{_ labels.name}</span>
								<span class="ml-3">{_ labels.width}</span>
								<span class="ml-3">{_ labels.class}</span>
								<span class="ml-3">{_ labels.helper}</span>
								<span class="">{_ labels.filter}</span>
							</div>
							{#each grid_columns as col}
								<div class="col-span-full grid grid-cols-subgrid items-center gap-2 px-3 py-2 border-b border-border last:border-b-0">
									<input type="hidden" name="grid_column_name" value="{= col.name }" />
									<label class="ml-3 flex cursor-pointer items-center gap-1.5">
										<input type="checkbox" name="grid_columns" value="{= col.name }" {#if col.default_selected}checked{/if} />
										<span>{= col.name }</span>
									</label>
									<input name="grid_column_width" value="{= col.width }" aria-label="{_ labels.width}: {= col.name }" />
									<input name="grid_column_class" value="{= col.class_name }" aria-label="{_ labels.class}: {= col.name }" />
									<select name="grid_column_helper" aria-label="{_ labels.helper}: {= col.name }">
										<option value="" {#if !col.helper}selected{/if}>{#if col.default_helper}{= col.default_helper } {_ labels.default }{:else}{_ labels.no_helper}{/if}</option>
										{#each helper_names as h}
											<option value="{= h }" {#if col.helper === h}selected{/if}>{= h }</option>
										{/each}
									</select>
									<input type="checkbox" name="grid_filter_columns" value="{= col.name }" aria-label="{_ labels.filter}: {= col.name }" {#if col.filter}checked{/if} />
								</div>
							{/each}
						{/if}
					</div>
				</div>
			</field-wrapper>

			<field-wrapper class="grid" data-field="prefix">
				<div class="grid">
					<label class="px-3" for="detail-prefix">{_ labels.prefix}</label>
					<input id="detail-prefix" name="prefix" pattern="[a-z0-9_\-\/]*" list="reeman-modules" title="{_ hints.prefix }" />
					<datalist id="reeman-modules">
						{#each modules as m}
							<option value="{= m.code }">{= m.name }</option>
						{/each}
					</datalist>
				</div>
			</field-wrapper>

			<field-wrapper class="grid" data-field="route_name">
				<div class="grid">
					<label class="px-3" for="detail-route-name">{_ labels.route_name}</label>
					<input id="detail-route-name" name="route_name" pattern="[a-z0-9_\-]*" title="{_ hints.route_name}" />
				</div>
			</field-wrapper>

			<field-wrapper class="grid" data-field="pagination">
				<div class="grid">
					<label class="px-3" for="detail-pagination">{_ labels.pagination}</label>
					<select id="detail-pagination" name="pagination">
						<option value="offset" selected>offset</option>
						<option value="cursor">cursor</option>
					</select>
				</div>
			</field-wrapper>

			<field-wrapper class="grid" data-field="render_strategy">
				<div class="grid">
					<label class="px-3" for="detail-render-strategy">{_ labels.render_strategy}</label>
					<select id="detail-render-strategy" name="render_strategy">
						<option value="load" selected>load</option>
						<option value="stream">stream</option>
					</select>
				</div>
			</field-wrapper>

			<field-wrapper class="grid" data-field="template_tags">
				<div class="grid">
					<label class="px-3" for="detail-template-tags">{_ labels.template_tags}</label>
					<select id="detail-template-tags" name="template_tags">
						<option value="flat">flat</option>
						<option value="tags" selected>tags</option>
					</select>
				</div>
			</field-wrapper>

			<div class="flex flex-wrap gap-x-4 gap-y-1 text-sm lg:col-span-2">
				<label class="flex cursor-pointer items-center gap-1.5"><input type="checkbox" name="force" value="1" /> {_ actions.force}</label>
				<label class="flex cursor-pointer items-center gap-1.5"><input type="checkbox" name="translate" value="1" /> {_ actions.translate}</label>
			</div>

			<div class="grid gap-3 lg:col-span-2">
				{#if busy}
					<app-banner type="yellow">{_ ui.busy}{#if busy.target}: <code>{= busy.target }</code>{/if}</app-banner>
				{/if}
				<div class="flex gap-2 items-center">
					<button type="submit" id="detail-submit" class="button primary" {#if busy}disabled{/if}>{_ actions.generate_crud}</button>
					<button type="button" onclick="history.back()" class="button secondary" {#if busy}disabled{/if}>{_ actions.cancel}</button>
				</div>
			</div>
		</form>
	</div>

	<script>
		document.querySelector("form").addEventListener("submit", () => {
			document.querySelectorAll("form button").forEach((btn) => { btn.disabled = true; });
		});
	</script>
{/with}
