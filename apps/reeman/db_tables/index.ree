{#layout("layout") }
{#with props}

	<div class="py-4">

		{#if busy}
			<div class="px-4 mb-4">
				<app-banner type="yellow">{_ ui.busy}{#if busy.target}: <code>{= busy.target }</code>{/if}</app-banner>
			</div>
		{/if}

		<!-- TABLE DISPLAY CONTROLLER -->
		<div class="flex items-center gap-1 justify-between w-full flex-wrap px-4">

			<div class="pagination-info">
				{#if first_url }
					<a href="{~ localized_path(first_url) }" role="button">
						<ree-icon name="chevrons_left"></ree-icon>
					</a>
				{:else }
					<ree-icon name="chevrons_left"></ree-icon>
				{/if}

				{#if prev_url }
					<a href="{~ localized_path(prev_url) }" role="button"><ree-icon name="chevron_left"></ree-icon></a>
				{:else }
					<ree-icon name="chevron_left"></ree-icon>
				{/if}

				{#if total > 0 }
					<div style="width: {= total.toString().length * 3 + 4 }ch; text-align: center">{= offset + 1 }-{= Math.min(offset + (limit === 'all' ? total : limit), total) } / {= total}</div>
				{:else }
					<div style="width: 7ch; text-align: center">0 / 0</div>
				{/if}

				{#if next_url }
					<a href="{~ localized_path(next_url) }" role="button">
						<ree-icon name="chevron_right"></ree-icon>
					</a>
				{:else }
					<ree-icon name="chevron_right"></ree-icon>
				{/if}

				{#if last_url }
					<a href="{~ localized_path(last_url) }" role="button">
						<ree-icon name="chevrons_right"></ree-icon>
					</a>
				{:else }
					<ree-icon name="chevrons_right"></ree-icon>
				{/if}
			</div>

			<div class="flex items-center gap-2">
				<select id="limit" class="w-[20ch]" onchange="navigate_to('limit', this.value)">
					{#each limit_options as option }
						<option value="{= option }" {#if option === limit }selected{/if}>
							{#if option==="all"}
								{_ selectors.all}
							{:else}
								{= option } {_ selectors.per_page}
							{/if}
						</option>
					{/each}
				</select>
			</div>

			<div class="flex items-center gap-2">
				<select id="order_by" class="w-[40ch]" onchange="navigate_to('order_by', this.value)">
					{#each sort_options as option }
						<option value="{= option.value }" {#if option.value === order_by }selected{/if}>{= props.translations.labels?.[option.field] || option.field } ({= option.direction === 'asc' ? props.translations.selectors.ascending : props.translations.selectors.descending })</option>
					{/each}
				</select>
			</div>

			<ree-filters action-url="/tables"></ree-filters>

			{#if enable_archive }
				<!-- BULK ACTIONS -->
				<div class="flex items-center gap-4 justify-start w-full flex-wrap px-4 my-4">
					<button id="action" commandfor="generate_dialog" command="show-modal" disabled class="button primary">{_ actions.generate_crud}</button>
					<button id="action_2" commandfor="refresh_dialog" command="show-modal" disabled class="button secondary">{_ actions.refresh_crud}</button>
					<button id="action_3" commandfor="schema_dialog" command="show-modal" disabled class="button secondary">{_ actions.schema_only}</button>
				</div>
			{/if}

		</div>

		<!-- TABLE GRID -->

		{#if (records.length === 0) }
			<p class="p-4">{_ ui.no_records}</p>

		{:else }

			<div class="grid gap-x-4 w-full bg-surface-raised shadow-lg mt-4" style="grid-template-columns: {= grid_cols }">

				<div class="col-span-full grid grid-cols-subgrid bg-neutral-200 font-semibold *:px-2 *:py-2 sticky top-0">
					{#if enable_archive }
						<div class="grid grid-cols-2 place-items-center p-0!">
							<button id="deselect_all" class="text-brand cursor-pointer"><ree-icon name="x" class="size-6"></ree-icon></button>
							<label class="w-full h-full grid place-items-center hover:bg-brand rounded">
								<input type="checkbox" name="select_all" id="select_all">
							</label>
						</div>
					{/if}
					<!-- GEN:FIELDS:HEADERS:START -->
					<div class="{= columns.name.class }">{_ labels.name }</div>
					<div class="{= columns.column_count.class }">{_ labels.column_count }</div>
					<div class="{= columns.fk_count.class }">{_ labels.fk_count }</div>
					<div class="{= columns.has_crud.class }">{_ labels.has_crud }</div>
					<!-- GEN:FIELDS:HEADERS:END -->
					<!-- filler cell for the trailing grid_filler track in grid_cols -->
					<div class="grid-filler"></div>
				</div>
				{#each records as record }
					<a href="{~ localized_path(route_edit_paths[record.name] || '/tables/' + record.name) }" class="col-span-full *:py-2 grid cursor-pointer grid-cols-subgrid border-b border-b-neutral-200 *:px-2 hover:bg-primary hover:text-white">

						{#if enable_archive }
							<div class="grid grid-cols-2 place-items-center p-0! m-0!">
								<div></div>
								<label class="w-full h-full grid place-items-center hover:bg-brand rounded" onclick="event.stopPropagation()">
									<input type="checkbox" name="checkboxes[]" value="{= record.name}" onclick="event.stopPropagation()">
								</label>
							</div>
						{/if}

						<!-- GEN:FIELDS:CELLS:START -->
						<div class="{= props.columns.name.class }">{= record.name }</div>
						<div class="{= props.columns.column_count.class }">{= record.column_count }</div>
						<div class="{= props.columns.fk_count.class }">{= record.fk_count }</div>
						<div class="{= props.columns.has_crud.class }">{~ yes_no(record.has_crud) }</div>
						<!-- GEN:FIELDS:CELLS:END -->
						<!-- filler cell for the trailing grid_filler track in grid_cols -->
						<div class="grid-filler"></div>
					</a>
				{/each}

			</div>
		{/if}

		{#if enable_archive }
			<!-- GENERATE CRUD DIALOG -->
			<dialog id="generate_dialog" class="p-0 rounded-xl shadow-2xl w-120">
				<form method="POST" action="{~ localized_path('/tables/bulk') }" id="generate_form" class="p-6">
					<input type="hidden" name="_csrf_token" value="{= csrf_token }" />
					<input type="hidden" name="return_to" value="/routes" />
					<h2 class="text-lg font-semibold">{_ actions.generate_crud}</h2>
					<p class="text-slate-600 mt-2">{_ ui.modifying} <span class="font-semibold text-brand" id="generate_count">0</span> {_ ui.records}.</p>
					<div class="grid gap-3 mt-4">
						<div class="flex flex-wrap gap-x-4 gap-y-1 text-sm">
							<label class="flex cursor-pointer items-center gap-1.5"><input type="checkbox" name="force" value="1" /> {_ actions.force}</label>
							<label class="flex cursor-pointer items-center gap-1.5"><input type="checkbox" name="translate" value="1" /> {_ actions.translate}</label>
						</div>
						<field-wrapper class="grid" data-field="prefix">
							<div class="grid">
								<label class="px-3" for="generate-prefix">{_ labels.prefix}</label>
								<input id="generate-prefix" name="prefix" pattern="[a-z0-9_\-\/]*" title="{_ hints.prefix }" />
							</div>
						</field-wrapper>
						<div class="grid grid-cols-3 gap-2">
							<field-wrapper class="grid" data-field="pagination">
								<div class="grid">
									<label class="px-3" for="generate-pagination">{_ labels.pagination}</label>
									<select id="generate-pagination" name="pagination">
										<option value="offset" selected>offset</option>
										<option value="cursor">cursor</option>
									</select>
								</div>
							</field-wrapper>
							<field-wrapper class="grid" data-field="render_strategy">
								<div class="grid">
									<label class="px-3" for="generate-render-strategy">{_ labels.render_strategy}</label>
									<select id="generate-render-strategy" name="render_strategy">
										<option value="load" selected>load</option>
										<option value="stream">stream</option>
									</select>
								</div>
							</field-wrapper>
							<field-wrapper class="grid" data-field="template_tags">
								<div class="grid">
									<label class="px-3" for="generate-template-tags">{_ labels.template_tags}</label>
									<select id="generate-template-tags" name="template_tags">
										<option value="flat">flat</option>
										<option value="tags" selected>tags</option>
									</select>
								</div>
							</field-wrapper>
						</div>
					</div>
					<div class="mt-6 flex justify-end gap-2">
						<button type="button" class="button secondary" commandfor="generate_dialog" command="close">{_ actions.cancel}</button>
						<button type="submit" class="button primary">{_ actions.do_it}</button>
					</div>
				</form>
			</dialog>

			<!-- REFRESH CRUD DIALOG -->
			<dialog id="refresh_dialog" class="p-0 rounded-xl shadow-2xl w-120">
				<form method="POST" action="{~ localized_path('/tables/bulk-refresh') }" id="refresh_form" class="p-6">
					<input type="hidden" name="_csrf_token" value="{= csrf_token }" />
					<input type="hidden" name="return_to" value="/tables" />
					<h2 class="text-lg font-semibold">{_ actions.refresh_crud}</h2>
					<p class="text-slate-600 mt-2">{_ ui.modifying} <span class="font-semibold text-brand" id="refresh_count">0</span> {_ ui.records}.</p>
					<p class="text-sm text-text-secondary mt-1">{_ ui.refresh_skip_hint}</p>
					<div class="grid gap-3 mt-4">
						<field-wrapper class="grid" data-field="mode">
							<div class="grid">
								<label class="px-3" for="refresh-mode">{_ labels.mode}</label>
								<select id="refresh-mode" name="mode">
									<option value="full" selected>{_ actions.full}</option>
									<option value="fields">{_ actions.fields}</option>
								</select>
							</div>
						</field-wrapper>
						<field-wrapper class="grid" data-field="template_tags">
							<div class="grid">
								<label class="px-3" for="refresh-template-tags">{_ labels.template_tags}</label>
								<select id="refresh-template-tags" name="template_tags">
									<option value="" selected>{_ selectors.default}</option>
									<option value="flat">flat</option>
									<option value="tags">tags</option>
								</select>
							</div>
						</field-wrapper>
					</div>
					<div class="mt-6 flex justify-end gap-2">
						<button type="button" class="button secondary" commandfor="refresh_dialog" command="close">{_ actions.cancel}</button>
						<button type="submit" class="button primary">{_ actions.do_it}</button>
					</div>
				</form>
			</dialog>

			<!-- SCHEMA ONLY DIALOG -->
			<dialog id="schema_dialog" class="p-0 rounded-xl shadow-2xl w-120">
				<form method="POST" action="{~ localized_path('/tables/bulk-schema') }" id="schema_form" class="p-6">
					<input type="hidden" name="_csrf_token" value="{= csrf_token }" />
					<input type="hidden" name="return_to" value="/tables" />
					<h2 class="text-lg font-semibold">{_ actions.schema_only}</h2>
					<p class="text-slate-600 mt-2">{_ ui.modifying} <span class="font-semibold text-brand" id="schema_count">0</span> {_ ui.records}.</p>
					<div class="grid gap-3 mt-4">
						<field-wrapper class="grid" data-field="prefix">
							<div class="grid">
								<label class="px-3" for="schema-bulk-prefix">{_ labels.prefix}</label>
								<input id="schema-bulk-prefix" name="prefix" pattern="[a-z0-9_\-\/]*" title="{_ hints.prefix }" />
							</div>
						</field-wrapper>
					</div>
					<div class="mt-6 flex justify-end gap-2">
						<button type="button" class="button secondary" commandfor="schema_dialog" command="close">{_ actions.cancel}</button>
						<button type="submit" class="button primary">{_ actions.do_it}</button>
					</div>
				</form>
			</dialog>

			<script src="/checkbox-group.js?v={= version}"></script>
			<script src="/dialog-confirm.js?v={= version}"></script>
			<script>
				const bulkCheckboxes = document.getElementById("select_all")
					? new CheckboxGroup({ buttonSelectors: ["#action", "#action_2", "#action_3"] })
					: null;

				// Inject one hidden "tables" input per checked checkbox into a dialog's
				// form right before submit - the reeman action handlers read
				// params.getAll("tables").
				function inject_selected_tables(form) {
					form.querySelectorAll('input[name="tables"]').forEach((el) => el.remove());
					const selected = $$('input[name="checkboxes[]"]:checked');
					for (const cb of selected) {
						const hidden = document.createElement("input");
						hidden.type = "hidden";
						hidden.name = "tables";
						hidden.value = cb.value;
						form.appendChild(hidden);
					}
				}

				for (const [form_id] of [["generate_form"], ["refresh_form"], ["schema_form"]]) {
					document.getElementById(form_id).addEventListener("submit", (e) => {
						inject_selected_tables(e.currentTarget);
					});
				}

				document.addEventListener("change", (e) => {
					if (e.target.name === "select_all" || e.target.name === "checkboxes[]") {
						const selected = $$('input[name="checkboxes[]"]:checked').length;
						for (const id of ["generate_count", "refresh_count", "schema_count"]) {
							document.getElementById(id).textContent = selected;
						}
					}
				});
			</script>
		{/if}
	</div>
{/with}
