{#layout("layout")}
{#with props}
	<div class="w-full p-4 space-y-6">

		<header class="flex flex-wrap items-center justify-between gap-3">
			<div>
				<h1 class="text-xl font-bold">{_ ui.refresh_title}</h1>
				<p class="text-sm text-text-secondary mt-1">{_ ui.refresh_description}</p>
			</div>
		</header>

		{#if form_error}
			<app-banner type="red">{= form_error}</app-banner>
		{/if}

		{#if busy}
			<app-banner type="yellow">{_ ui.busy}{#if busy.target}: <code>{= busy.target }</code>{/if}</app-banner>
		{/if}

		<section class="grid reeman-card-grid gap-4">
			<form method="POST" action="{~ localized_path('/sync-translations') }" class="flex flex-col gap-3 rounded-md border border-border bg-surface-raised p-4">
				<input type="hidden" name="_csrf_token" value="{= csrf_token }" />
				<input type="hidden" name="return_to" value="/refresh" />
				<div class="flex items-center justify-between gap-2">
					<h2 class="font-semibold">{_ actions.sync_translations}</h2>
					<span class="pill-layout bg-neutral-200 text-xs">i18n</span>
				</div>
				<label class="flex cursor-pointer items-center gap-1.5 text-sm">
					<input type="checkbox" name="translate" value="1" /> {_ actions.translate}
				</label>
				<button type="submit" class="as-button-primary mt-auto">{_ actions.sync_translations}</button>
			</form>

			<form method="POST" action="{~ localized_path('/sync-locale-tables') }" class="flex flex-col gap-3 rounded-md border border-border bg-surface-raised p-4">
				<input type="hidden" name="_csrf_token" value="{= csrf_token }" />
				<input type="hidden" name="return_to" value="/refresh" />
				<h2 class="font-semibold">{_ actions.sync_locale_tables}</h2>
				<button type="submit" class="as-button-primary mt-auto">{_ actions.sync_locale_tables}</button>
			</form>

			<form method="POST" action="{~ localized_path('/add-locale') }" class="flex flex-col gap-3 rounded-md border border-border bg-surface-raised p-4">
				<input type="hidden" name="_csrf_token" value="{= csrf_token }" />
				<input type="hidden" name="return_to" value="/refresh" />
				<div class="flex items-center justify-between gap-2">
					<h2 class="font-semibold">{_ actions.add_locale}</h2>
					<span class="pill-layout bg-neutral-200 text-xs">i18n</span>
				</div>
				<field-wrapper class="grid" data-field="locale_code">
					<div class="grid">
						<label class="px-3" for="add-locale-code">{_ labels.locale_code}</label>
						<input id="add-locale-code" name="locale_code" required pattern="[a-z]{2,3}(-[a-z0-9]{2,8})?" title="{_ hints.locale_code }" />
						<validation-error class="mt-1" id="error-locale_code"></validation-error>
					</div>
				</field-wrapper>
				<label class="flex cursor-pointer items-center gap-1.5 text-sm">
					<input type="checkbox" name="translate" value="1" /> {_ actions.translate}
				</label>
				<button type="submit" class="as-button-primary mt-auto">{_ actions.add_locale}</button>
			</form>
		</section>
	</div>
{/with}
