# ===========================================================================
# Reepolee environment. Copied to .env on install (scripts/copy_env.ts).
# Ordered by how often a developer touches each setting: core first,
# optional features next, test-only and external integrations last.
# ===========================================================================

DEEPL_API_KEY=N/A

# -- Core: database & server -- (required to boot)
# Development DB - used by `bun dev`, reeman, the generators and every script
# under scripts/. Development tooling only ever touches this one.
DEV_CONNECTION_STRING=sqlite:app.db
# DEV_CONNECTION_STRING="mysql://localhost/reepolee_dev"
DEV_DB_USERNAME=N/A
DEV_DB_PASSWORD=N/A
# Production DB - used only when the server is started with --prod
# (`bun start` / `bun run start:reeqa`). Required to boot in production.
PROD_CONNECTION_STRING=sqlite:app.db
# PROD_CONNECTION_STRING="mysql://localhost/reepolee"
PROD_DB_USERNAME=N/A
PROD_DB_PASSWORD=N/A
# Test DB - used by `bun test` and `bun run db:clone-test`. Must contain "test"
# in the DB name; the safety guard refuses non-test DBs. Fails LOUD if unset.
TEST_CONNECTION_STRING=sqlite:test.db
TEST_DB_USERNAME=N/A
TEST_DB_PASSWORD=N/A
TIME_ZONE=Europe/London
PORT=2338
# Port used by the main app under the --test flag (binds to 127.0.0.1 only).
# Defaults to 2600. The smoke test script also defaults to 2600. "N/A"
# (default) or unset uses the test default.
TEST_PORT=N/A
# Port for the optional reeman app (server.reeman.ts, `bun run dev:reeman`) - a
# second process serving the reeman/studio/system-admin pages from this same
# checkout. Independent origin from PORT; both resolve to the same users row.
REEMAN_PORT=2339
# Port for the ReeQA app. Required; no fallback is used.
REEQA_PORT=2340
# Base URL of the main app, used by the reeman process to notify it of
# translations-only changes across the two-app split.
MAIN_APP_URL=http://localhost:2338
# Public base URL used for links to the separate Reeman and ReeQA dev apps.
# Set this to https://your-domain in a TLS-terminated deployment.
SITE_URL=N/A
SERVER_NAME=localhost

# -- Quick Start admin defaults --
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
# "N/A" (default) leaves the admin without a preset password - you are prompted
# to type one instead of accepting a weak default.
ADMIN_PASSWORD=N/A

# Optional: complete Ree-web Publisher signal endpoint. Successful CRUD
# mutations notify it on a best-effort basis and never depend on its response.
# Both must be set: the signal is only sent when REEWEB_PUBLISHER_ENABLED=true,
# so the URL can stay configured while the publisher is not running.
# REEWEB_PUBLISHER_ENABLED=false
# REEWEB_PUBLISHER_URL=http://localhost:3011/api/render-signal

# -- Sessions --
# "sql" (default, no extra services) or "redis" (requires REDIS_URL below).
SESSION_STORE="sql"

# -- CSRF --
# HMAC key for signing CSRF tokens. REQUIRED in production (--prod), where the
# server refuses to boot without it: a secret regenerated per boot invalidates
# every form that was open across a restart. Must be >= 32 chars. Dev and test
# fall back to an ephemeral per-process value. "N/A" (default) uses that
# ephemeral fallback. Generate with: openssl rand -base64 48
CSRF_SECRET=N/A
# CSRF_SECRET=""

# -- Storage --
# "local" keeps uploads on disk; "s3" uses the S3 block further down.
STORAGE="local"
LOCAL_STORAGE_DIR="../storage"

# -- Email (SMTP) --
# SMTP_ENABLED is the switch: "false" (default) disables email delivery
# without losing the values below, so flipping it back on doesn't require
# re-entering all five fields. Once "true", every field below must be set to
# a real value - a partial group (switch on, any field still "N/A") fails
# loud at boot instead of failing wherever send_mail() happens to run first.
SMTP_ENABLED=false
# SMTP_ENABLED=true
SMTP_HOST=N/A
# SMTP_HOST="sandbox.smtp.mailtrap.io"
SMTP_PORT=N/A
# SMTP_PORT=587
SMTP_USERNAME=N/A
# SMTP_USERNAME="xxxxxxxxxxxxxx"
SMTP_PASSWORD=N/A
# SMTP_PASSWORD="yyyyyyyyyyyyyy"
SMTP_FROM=N/A
# SMTP_FROM="example@example.com"

# -- Common app toggles --
SQL_LOGGING=false
# Upload size limit in MB, shared by image uploads and the json-to-sql tool.
# Required - no fallback: missing, blank, or "N/A" fails loudly at the upload
# point instead of silently applying a default.
MAX_UPLOAD_SIZE_MB=10

# -- Content localization --
# When "true", reeman marks every text/textarea/markdown field `localized: true`
# in newly generated schema/table.ts columns (per-field overrides in
# localized_values, one row per locale - see config/supported_locales.ts).
# Only applies to tables with an auto-increment id; skip and set individual
# fields' `localized: true` by hand otherwise. Existing table.ts files are
# never rewritten - toggle a field's flag manually to opt in or out later.
LOCALIZE_CONTENT=false

# -- JS bundling --
# GROUP_JS: off by default. Set to "true" (or "on") to group per-page
# <script src> tags into one immediate and one deferred file each, cached to
# disk. Unset or "false" leaves each script tag as its own request instead.
GROUP_JS=true
# BUNDLE_JS: set to "true" to additionally minify the grouped output via
# Bun.build. Off by default: bundled scripts are hand-authored globals
# (functions/classes attached to window), and Bun's dead-code elimination
# can silently drop declarations only referenced by inline <script> blocks
# elsewhere on the page. Only enable once all bundled sources are confirmed
# safe to minify. Has no effect when GROUP_JS=false.
BUNDLE_JS=false

# -- MCP server --
# STDIO starts with `bun run mcp`. Streamable HTTP starts with `bun run
# mcp:http`, binds only to 127.0.0.1, and requires MCP_HTTP_TOKEN.
# Template rendering and all mutation tools are disabled by default.
MCP_ENABLE_TEMPLATE_RENDER=false
MCP_ENABLE_MUTATIONS=false
# Port reported to MCP clients by the `project` tool as the app's server port.
# Defaults to 2400.
MCP_SERVER_PORT=2400
# Streamable HTTP endpoint port and bearer token. "N/A" keeps HTTP unavailable.
MCP_HTTP_PORT=2401
MCP_HTTP_TOKEN=N/A
# MCP_HTTP_TOKEN="generate-at-least-32-random-characters"

# -- Internal admin endpoints --
# Disabled by default. Set both values in the deployment environment only when
# translation reload and rate-limit endpoints are required. Generate a 32+ byte
# secret with: openssl rand -hex 32
INTERNAL_ADMIN_ENDPOINTS=false
RELOAD_SECRET=N/A
# RELOAD_SECRET="019fec81-7da5-726a-ba73-d0a60441e8f2"

# ===========================================================================
# Redis (optional) - sessions, SQL cache, background queue.
# Redis is off by default: set REDIS_ENABLED=true (or "on") AND a real
# redis:// REDIS_URL to enable it; "N/A" (default) keeps the Redis-free
# install on the SQL stores. Rate limiting (further down) uses Redis when
# Redis is enabled but falls back to the SQL database, so it does not require
# Redis.
# ===========================================================================
# Switch for Redis. Only "true" or "on" enables it; anything else (unset,
# "false", "N/A") keeps Redis off while REDIS_URL stays configured - sessions,
# cache, queue, rate limiting and feature flags all fall back to their SQL
# equivalents. A configured REDIS_URL alone no longer enables anything.
REDIS_ENABLED=false
# REDIS_ENABLED=true
REDIS_URL=N/A
# REDIS_URL="redis://localhost:6379"
# Real Redis for Redis-backed tests (e.g. cache.test.ts). Use a different DB
# number (e.g. /1) to isolate from the dev server. "N/A" (default) skips those
# tests.
TEST_REDIS_URL=N/A
# TEST_REDIS_URL=redis://localhost:6379/1

# -- Redis SQL cache --
# Set to "true" to enable Redis-backed caching of search_records queries.
# Requires REDIS_ENABLED=true and REDIS_URL. Falls back silently when disabled.
CACHE_ENABLED=false
# Max serialized bytes for a cached value (default: 524288 = 512 KB). "N/A"
# falls back to the default.
CACHE_MAX_BYTES=N/A
# Max record count for cached query results (default: 500). "N/A" falls back
# to the default.
CACHE_MAX_RECORDS=N/A

# -- Rate limiting --
# Required in production. Set both values in the deployment environment.
# Local development may leave them unset. "false" (default) disables limiting.
RATE_LIMITING=false
#
# TRUST_PROXY tells the limiter how to find the real client IP for anonymous
# traffic. Production requires one of the two modes below; anything else exits.
# Logged-in users are keyed by session cookie and are unaffected either way.
#
#   cloudflare - Cloudflare is the ONLY path to the origin; CF-Connecting-IP is
#                trusted. Allow only Cloudflare IP ranges at the origin firewall
#                so the header cannot be spoofed.
#   direct     - No proxy in front. The socket peer address is used, which the
#                client cannot spoof. Correct for LAN / direct-to-origin only:
#                behind a proxy every request reports the proxy's address and
#                all anonymous traffic collapses into one bucket.
#
TRUST_PROXY=N/A
# TRUST_PROXY=cloudflare
# TRUST_PROXY=direct
#
# RATE_LIMITING=true does NOT require Redis. The counter store is picked from
# config: Redis when REDIS_URL is set, otherwise the SQL database via the
# rate_limit_counters table. Expired counters are swept every 5 minutes on the
# SQL path; Redis expires its own keys.

# ===========================================================================
# S3 object storage (only when STORAGE="s3")
# ===========================================================================

# Connection - split style (preferred). Endpoint is built as
# S3_PROTOCOL://S3_HOSTNAME:S3_PORT.
S3_HOSTNAME="localhost"
S3_PORT=8333
S3_PROTOCOL="http"

# Credentials
S3_ACCESS_KEY_ID="user"
S3_SECRET_ACCESS_KEY="user1234"

# Region (optional)
S3_REGION="auto"

# Image bucket - used for uploaded images via the image editor. Default: "images"
S3_IMAGE_BUCKET="images"
# File bucket - used for uploaded documents via the file library. Default: "files"
S3_FILE_BUCKET="files"

# -- Local storage path override (when S3 is not configured) --
# If set, avatars and uploaded images are stored outside the application
# directory so they survive reinstalls. Sub-directories mirror S3 mount buckets
# (avatars/ and images/). If unset, avatars fall back to static/avatars/.
# LOCAL_STORAGE_DIR="/opt/reepolee-data"

# ===========================================================================
# Dev issue reporter screenshots (optional, dev-only)
# ===========================================================================
# Ctrl+Shift+I in `bun dev` opens a GitHub issue reporter overlay. Attached
# screenshots are committed to the issue repo itself, on an orphan `screenshots`
# branch, through the GitHub contents API - so there is nothing to configure
# here. Authentication is the same `gh auth login` the issue reporter already
# needs; no bucket, no keys, no third-party host.
#
# The branch is created on first upload. Each screenshot is a linked image:
# the clickable link uses the authenticated github.com/<repo>/blob/screenshots/...
# URL, while the image source uses github.com/<repo>/raw/screenshots/... (the
# blob URL returns an HTML page and cannot be an image source). Both hosts carry
# the reader's session cookie, so they render inside a private repo's issue.
# If an upload fails the issue is still filed, with a note naming the
# screenshots that did not make it.

# ===========================================================================
# Dev source inspector (optional, dev-only)
# ===========================================================================
# Meta+Shift (Cmd/Win+Shift) hover/click in `bun dev` edits translated text
# in place, opens a dialog for markup translations, or opens the stamped
# block's source file in your editor. Alt+Shift edits a tag's class attribute.
# OPEN_IDE selects which editor the "open in editor" tier launches; unset,
# that tier reports a clear error but the rest of the inspector still works.
# One of: vscode, zed, nvim, sublime, idea. "N/A" (default) leaves the
# "open in editor" tier disabled (it reports a clear error).
OPEN_IDE=N/A

# ===========================================================================
# AI / translation provider (optional) - configure exactly one provider.
# ===========================================================================

# -- OpenRouter --
OPENROUTER_KEY=N/A
OPENROUTER_MODEL=N/A
# OPENROUTER_KEY=sk-or-v1-xxxxxxxxxxxxxx
# OPENROUTER_MODEL=poolside/laguna-xs-2.1:free

# -- Gemini --
GEMINI_API_KEY=N/A
GEMINI_MODEL=N/A
# GEMINI_API_KEY=xxxxxxxxxxxxxx
# GEMINI_MODEL=gemini-2.5-flash

# -- OpenAI --
OPENAI_API_KEY=N/A
OPENAI_MODEL=N/A
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxx
# OPENAI_MODEL=gpt-4o-mini

# -- Claude --
CLAUDE_API_KEY=N/A
CLAUDE_MODEL=N/A
# CLAUDE_API_KEY=sk-ant-xxxxxxxxxxxxxx
# CLAUDE_MODEL=claude-sonnet-4-20250514

# -- xAI Grok --
XAI_API_KEY=N/A
XAI_MODEL=N/A
# XAI_API_KEY=xai-xxxxxxxxxxxxxx
# XAI_MODEL=grok-4

# -- DeepL Free -- Uses https://api-free.deepl.com/v2/translate.
DEEPL_API_KEY=N/A
# DEEPL_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx:fx

# -- Local LLM (Ollama) -- takes priority over all other providers when set.
OLLAMA_URL=N/A
OLLAMA_MODEL=N/A
# OLLAMA_URL="http://localhost:11434"
# OLLAMA_MODEL="gemma4:e4b"

# -- HF Inference API --
# Language code (e.g. "en-sl") is derived automatically and appended to HF_MODEL.
HF_URL=N/A
HF_MODEL=N/A
HF_TOKEN=N/A
# HF_URL="https://router.huggingface.co/hf-inference/models"
# HF_MODEL="Helsinki-NLP/opus-mt"
# HF_TOKEN="hf_*****"

# ===========================================================================
# Agent mode (optional, testing)
# ===========================================================================

# Required by `bun run agent` - the server exits without it (never falls back to 2338)
# "N/A" (default) = agent mode off.
AGENT_SERVER_PORT=N/A
# AGENT_SERVER_PORT=2500
AGENT_REEMAN_SERVER_PORT=N/A
# AGENT_REEMAN_SERVER_PORT=2501
# Dedicated port for the ReeQA app's agent mode. "N/A" (default) = agent mode off.
AGENT_REEQA_SERVER_PORT=N/A
# Optional shared secret for agent-mode auth (defense-in-depth). "N/A" (default)
# requires no secret.
AGENT_SECRET=N/A
AGENT_USER_USERNAME=admin

# ===========================================================================
# Cloudflare D1 (optional) - edge registration sync
# ===========================================================================

# Credentials for lib/d1_client.ts, used to pull edge applications from a
# Cloudflare D1 database into origin tables via lib/table_sync.ts.
# "N/A" (default) = D1 client disabled.
CF_API_TOKEN=N/A
CF_ACCOUNT_ID=N/A
CF_D1_DATABASE_ID=N/A
# CF_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxx
# CF_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxx
# CF_D1_DATABASE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ===========================================================================
# Web Push (optional)
# ===========================================================================
# Generate a VAPID P-256 key pair with a trusted local tool. Web Push remains
# disabled until all three values are real. The private key must never be sent
# to the browser.
WEB_PUSH_PUBLIC_KEY=N/A
WEB_PUSH_PRIVATE_KEY=N/A
WEB_PUSH_SUBJECT=http://localhost:2338
