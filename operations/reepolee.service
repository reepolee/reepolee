[Unit]
Description=Reepolee App Server
After=network.target

[Service]
Type=simple
User=ales
WorkingDirectory=/home/ales/reepolee
ExecStart=/home/ales/.bun/bin/bun --hot /home/ales/reepolee/apps/main/server.ts --prod
Restart=always
RestartSec=5
Environment=NODE_ENV=production
# Required: the server refuses to boot without it under --prod. Must be >= 32
# chars and must NOT change between deploys - a new value invalidates every
# form open in a browser. Generate once with: openssl rand -base64 48
# Environment=CSRF_SECRET=

[Install]
WantedBy=multi-user.target
