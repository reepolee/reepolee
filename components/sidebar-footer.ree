<footer class="bottom px-4 py-4">
	<details class="relative">
		<summary class="cursor-pointer list-none font-semibold pl-2">
			{#if props.user}{= props.user.display_name}{:else}Anonymous{/if}
		</summary>
		<div class="absolute bottom-full left-0 z-10 mb-2 grid min-w-56 gap-2 rounded border border-border bg-surface-raised p-3 shadow">
			{#each props.nav_final_links as entry}
				{#if entry.requires_user === !!props.user}
					<a href="{~ localized_path(entry.url) }" class="rounded border border-border bg-surface-raised text-text-primary px-3 py-2 text-left text-xs shadow hover:bg-surface-sunken no-underline">
						{#if entry.key === "profile"}{_ nav_auth.profile}{:else}{_ nav_auth.login}{/if}
					</a>
				{/if}
			{/each}
			<span class="text-xs font-semibold text-text-secondary">{_ ui.languages}</span>
			<locale-switcher class="w-full"></locale-switcher>
			<button id="theme-toggle" aria-label="Toggle dark mode" data-dark-label="{_ ui.theme_dark}" data-light-label="{_ ui.theme_light}" class="flex w-full cursor-pointer items-center gap-2 rounded border border-border bg-surface-raised text-text-primary px-3 py-2 text-left text-xs shadow hover:bg-surface-sunken"><span data-theme-icon class="shrink-0">☀️</span><span data-theme-label class="whitespace-nowrap">{_ ui.theme_dark}</span></button>

			{#if props.user && props.web_push_enabled}
				<button
					id="web-push-toggle"
					type="button"
					class="flex w-full cursor-pointer items-center gap-2 rounded border border-border bg-surface-raised text-text-primary px-3 py-2 text-left text-xs shadow hover:bg-surface-sunken"
					data-enabled-label="{_ ui.notifications_disable}"
					data-disabled-label="{_ ui.notifications_enable}"
					data-error-label="{_ ui.notifications_unavailable}"
				>
					<span data-web-push-icon-on class="shrink-0" hidden><ree-icon name="notifications_are_on" class="size-4"></ree-icon></span>
					<span data-web-push-icon-off class="shrink-0"><ree-icon name="notifications_are_off" class="size-4"></ree-icon></span>
					<span data-web-push-label class="whitespace-nowrap">{_ ui.notifications_enable}</span>
				</button>
			{/if}
		</div>
	</details>
</footer>
