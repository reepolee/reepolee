<field-wrapper class="grid lg:col-span-2 lg:grid-cols-subgrid" data-field="{= props.attributes.name }">
	<div class="grid">
		<label class="px-3 mb-1">{= props.attributes.label}</label>
		<input type="hidden" name="{= props.attributes.name }" id="{= props.attributes.name }-input" value="{= props.attributes.value }" />
		<div class="flex flex-col gap-3 px-3">
			{#each props.attributes.options ?? [] as tag}
				<label class="flex items-center gap-1.5 text-sm cursor-pointer">
					<input type="checkbox" class="{= props.attributes.name }-checkbox" value="{= tag.tag_key}" {#if props.attributes.value && props.attributes.value.split(/[\s,]+/).filter(Boolean).includes(tag.tag_key)}checked{/if} />
					{= tag.tag_value}
				</label>
			{/each}
		</div>
		<validation-error class="mt-1" id="error-{= props.attributes.name }"></validation-error>
		<script>
			(() => {
				const hidden = document.getElementById("{~ props.attributes.name }-input");
				const checkboxes = document.querySelectorAll(".{~ props.attributes.name }-checkbox");

				function updateTags() {
					const checked = Array.from(checkboxes)
					.filter((cb) => cb.checked)
					.map((cb) => cb.value);
					hidden.value = checked.join(",");
				}
				checkboxes.forEach((cb) => cb.addEventListener("change", updateTags));
			})();
		</script>
	</div>
</field-wrapper>
