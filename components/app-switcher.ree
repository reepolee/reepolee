{#if props.is_dev && props.dev_apps && props.dev_apps.length > 0}
	<div class="ml-auto flex items-center gap-1" aria-label="{_ ui.app_switcher }">
		{#each props.dev_apps as app}
			{#if user_has_module(props.user, app.module)}
				<a
					href="{= app.url }"
					class="as-icon text-xs hover:border-neutral-300 hover:bg-neutral-100 {= app.current ? 'bg-neutral-100 ring-1 ring-brand' : '' }"
					aria-label="{= props.translations?.ui?.apps?.[app.name] ?? `{${app.name}}` }"
					title="{= props.translations?.ui?.apps?.[app.name] ?? `{${app.name}}` }"
					{#if app.current}aria-current="page"{/if}
				>
					<ree-icon name="{= app.icon }" class="size-4 text-brand"></ree-icon>
				</a>
			{/if}
		{/each}
	</div>
{/if}
