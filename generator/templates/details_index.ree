<!-- GEN:CHILDREN:START -->
{#if record.id}
	<div class="child-list mt-0 bg-surface-raised rounded shadow p-4 max-w-none" data-child-section="__child.table__">
		<h2 class="text-lg font-semibold mb-4">{_ __child.translation_namespace__.parent_label}</h2>
		{#if props.__child.records__ && props.__child.records__.length > 0}
			<div class="grid gap-x-8 items-center font-semibold" __child.grid_cols__>
				__child.headers__
				<div class="child-header text-right px-2">{_ __child.translation_namespace__.child_ui.actions}</div>
				{#each props.__child.records__ as child}
					<div class="grid grid-cols-subgrid col-span-full items-center border-t border-slate-100 py-2 hover:bg-slate-200/50 font-normal">
						__child.cells__

						<div class="flex items-center justify-end gap-2 px-2">
							<button type="button" class="as-button-tertiary size-7 p-0" data-edit-child data-child-id="{= child.id }" title="{_ __child.translation_namespace__.child_ui.edit}">📝</button>
							<button type="button" class="as-button-tertiary size-7 p-0 text-text-tertiary hover:text-brand" data-delete-child data-child-id="{= child.id }" command="show-modal" commandfor="child-delete-dialog-__child.table__" title="{_ __child.translation_namespace__.child_ui.archive}"><!-- bare `delete` would break - `delete` is a JS keyword -->🗑️</button>
						</div>
					</div>
				{/each}
			</div>
		{:else}
			<p class="text-slate-400 italic">{_ __child.translation_namespace__.child_ui.empty_text}</p>
		{/if}
		<button type="button" class="as-button-primary mt-4 inline-flex items-center gap-1" data-new-child>{_ __child.translation_namespace__.child_ui.new_button}</button>
	</div>

	<!-- Child CRUD dialog -->
	<dialog id="child-dialog-__child.table__" class="p-0 rounded-xl shadow-2xl w-[90vw] max-w-[60ch] max-h-[90vh]">
		<div class="p-6 overflow-y-auto max-h-[80vh]">
			<div class="flex items-center justify-between mb-4">
				<h2 id="child-dialog-title-__child.table__" class="text-lg font-semibold">{_ __child.translation_namespace__.child_ui.new_title}</h2>
				<button type="button" class="as-button-tertiary p-1 text-2xl leading-none" commandfor="child-dialog-__child.table__" command="close">&times;</button>
			</div>

			<div id="child-form-errors-__child.table__" class="hidden py-4">
				<app-banner type="red"><span id="child-form-errors-text-__child.table__"></span></app-banner>
			</div>

			<form id="child-form-__child.table__" class="grid gap-4">
				{#with props}
					<input type="hidden" name="_csrf_token" value="{= csrf_token }" />
					<input type="hidden" name="__child.fk_column__" id="child-parent-fk-__child.table__" value="" />

					<!-- GEN:CHILD:FIELDS:START -->
					__child.input_fields__
					<!-- GEN:CHILD:FIELDS:END -->

					<div class="flex gap-2 mt-6 items-center">
						<button id="child-btn-submit-__child.table__" type="submit" class="as-button-primary">{_ __child.translation_namespace__.actions.save}</button>
						<button type="button" class="as-button-secondary" commandfor="child-dialog-__child.table__" command="close">{_ __child.translation_namespace__.actions.cancel}</button>
					</div>
				{/with}
			</form>
		</div>
	</dialog>

	<!-- Child delete confirmation dialog -->
	<dialog id="child-delete-dialog-__child.table__" class="p-0 rounded-xl shadow-2xl w-100">
		<div class="p-6">
			<h2 class="text-lg font-semibold">{_ __child.translation_namespace__.actions.archive}</h2>
			<div class="mt-6 flex justify-end gap-2">
				<button class="as-button-secondary" type="button" commandfor="child-delete-dialog-__child.table__" command="close">{_ __child.translation_namespace__.actions.cancel}</button>
				<button id="child-btn-confirm-delete-__child.table__" class="as-button-danger" type="button" command="--confirm" commandfor="child-delete-dialog-__child.table__">{_ __child.translation_namespace__.actions.confirm_archive}</button>
			</div>
		</div>
	</dialog>

	<script>
	(() => {
		const container = document.querySelector('[data-child-section="__child.table__"]');
		if (!container) return;
		const dialog = document.getElementById("child-dialog-__child.table__");
		const form = document.getElementById("child-form-__child.table__");
		const title = document.getElementById("child-dialog-title-__child.table__");
		const errors = document.getElementById("child-form-errors-__child.table__");
		const errors_text = document.getElementById(
		"child-form-errors-text-__child.table__",
		);
		const parent_fk = document.getElementById("child-parent-fk-__child.table__");
		const submit_btn = document.getElementById(
		"child-btn-submit-__child.table__",
		);
		const csrf_token = document.cookie.match(/csrf_token=([^;]+)/)?.[1] || "";
		// Base path for child CRUD URLs - computed server-side via template scope
		const child_base_path =
		"{~ localized_path('/__parent.table__/' + props.record.__parent.route_param__ + '/__child.table__') }";
		const parent_val = "{= props.record.__parent.route_param__ }";
	
		function qs(sel) {
			return form.querySelector(sel);
		}
	
		function fill_form(record, localized_values) {
			__child.form_fill_js__;
			for (const [key, value] of Object.entries(localized_values)) {
				const separator = key.lastIndexOf("|");
				if (separator < 1) continue;
				const field_name = key.slice(0, separator);
				const locale = key.slice(separator + 1);
				const input_name = `_lv[${field_name}][${locale}]`;
				const input = qs(`[name="${input_name}"]`);
				const original = qs(`[name="_original_${input_name}"]`);
				if (input) input.value = value ?? "";
				if (original) original.value = value ?? "";
			}
		}
	
		function clear_form() {
			__child.form_clear_js__;
			form.querySelectorAll('[name^="_lv["], [name^="_original__lv["]').forEach((input) => {
				input.value = "";
			});
		}
	
		function hide_error() {
			errors.classList.add("hidden");
		}
	
		function show_error(msg) {
			errors_text.textContent = msg;
			errors.classList.remove("hidden");
		}
	
		function clear_field_errors() {
			const error_fields = [__child.error_field_list__];
			error_fields.forEach((name) => {
				const el = document.getElementById(`error-${name}`);
				if (el) el.innerHTML = "";
			});
		}
	
		function set_field_errors(errors) {
			for (const [name, msg] of Object.entries(errors)) {
				const el = document.getElementById(`error-${name}`);
				if (el) el.innerHTML = msg;
			}
		}
	
		// Edit buttons - scoped to this child's container
		container.querySelectorAll("[data-edit-child]").forEach((btn) => {
			btn.addEventListener("click", async function() {
				const child_id = this.dataset.childId;
				hide_error();
				clear_field_errors();
	
				try {
					const res = await fetch(
					`${child_base_path}/${child_id}/edit-data`,
					);
					const data = await res.json();
					if (data.error) {
						show_error(data.error);
						return;
					}
					fill_form(data.record, data.localized_values || {});
					parent_fk.value = parent_val;
					form.action = `${child_base_path}/${child_id}/edit`;
					title.textContent = "{_ __child.translation_namespace__.child_ui.edit_title}";
					submit_btn.textContent = "{_ __child.translation_namespace__.actions.save}";
					dialog.showModal();
				} catch (e) {
					show_error("{_ __child.translation_namespace__.child_ui.error_loading}");
				}
			});
		});
	
		// New button - scoped to this child's container
		const new_btn = container.querySelector("[data-new-child]");
		if (new_btn) {
			new_btn.addEventListener("click", () => {
				hide_error();
				clear_field_errors();
				clear_form();
				parent_fk.value = parent_val;
				form.action = child_base_path;
				title.textContent = "{_ __child.translation_namespace__.child_ui.new_title}";
				submit_btn.textContent = "{_ __child.translation_namespace__.actions.save}";
				dialog.showModal();
			});
		}
	
		// Form submit
		form.addEventListener("submit", async (e) => {
			e.preventDefault();
			hide_error();
			submit_btn.disabled = true;
			submit_btn.textContent = "{_ __child.translation_namespace__.actions.submitted}";
	
			try {
				const form_data = new FormData(form);
				const res = await fetch(form.action, {
					method: "POST",
					body: new URLSearchParams(form_data),
				});
				const data = await res.json();
	
				if (data.success) {
					dialog.close();
					window.location.reload();
				} else {
					if (data.errors) {
						set_field_errors(data.errors);
					}
					show_error(
					data.form_errors
					|| "{_ __child.translation_namespace__.child_ui.error_saving}",
					);
					submit_btn.disabled = false;
					submit_btn.textContent = "{_ __child.translation_namespace__.actions.save}";
				}
			} catch (e) {
				show_error("{_ __child.translation_namespace__.child_ui.error_saving}");
				submit_btn.disabled = false;
				submit_btn.textContent = "{_ __child.translation_namespace__.actions.save}";
			}
		}); // Blur validation
		form.addEventListener("focusout", async (e) => {
			const el = e.target;
			if (!el || !el.name || el.tagName === "BUTTON") return;
	
			try {
				const fd = new FormData(form);
				const values = Object.fromEntries(fd.entries());
				values.touched = [el.name];
	
				const res = await fetch(`${child_base_path}/validate`, {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify(values),
				});
				const data = await res.json();
				if (data.errors) {
					const error_el = document.getElementById(`error-${el.name}`);
					if (error_el) error_el.innerHTML = data.errors[el.name] || "";
				} else {
					// Clear this field's error if validation passed
					const error_el = document.getElementById(`error-${el.name}`);
					if (error_el) error_el.innerHTML = "";
				}
			} catch (e) {
				// Silent fail for blur validation
			}
		});
	
		// Child delete confirmation dialog
		const delete_dialog = document.getElementById(
		"child-delete-dialog-__child.table__",
		);
		const delete_confirm_btn = document.getElementById(
		"child-btn-confirm-delete-__child.table__",
		);
		let pending_delete_id = "";
		let delete_in_flight = false;

		// Trash buttons - capture target id directly on click, independent of
		// the "show-modal" command event (avoids a race with dialog-confirm.js
		// reopening the dialog).
		container.querySelectorAll("[data-delete-child]").forEach((btn) => {
			btn.addEventListener("click", function() {
				pending_delete_id = this.dataset.childId;
			});
		});

		if (delete_dialog) {
			delete_dialog.addEventListener("command", async (e) => {
				if (e.command === "show-modal") return;
				if (e.command !== "--confirm") return;
				if (delete_in_flight) return;
				delete_in_flight = true;
				delete_dialog.close();
				const original_text = delete_confirm_btn.textContent;
				delete_confirm_btn.disabled = true;
				delete_confirm_btn.textContent = "{_ __child.translation_namespace__.child_ui.archiving}";
	
				try {
					const res = await fetch(
					`${child_base_path}/${pending_delete_id}/edit`,
					{
						method: "POST",
						headers: {
							"Content-Type": "application/x-www-form-urlencoded",
							"X-CSRF-Token": csrf_token,
						},
						body: new URLSearchParams({
							_action: "delete",
							_csrf_token: csrf_token,
						}),
					},
					);
					const data = await res.json();
					if (data.success) {
						window.location.reload();
					} else {
						delete_in_flight = false;
						delete_confirm_btn.disabled = false;
						delete_confirm_btn.textContent = original_text;
						add_toast({
							type: "red",
							message: data.error || "{_ __child.translation_namespace__.child_ui.error_archiving}",
							duration: 4000,
						});
					}
				} catch (e) {
					delete_in_flight = false;
					delete_confirm_btn.disabled = false;
					delete_confirm_btn.textContent = original_text;
					add_toast({
						type: "red",
						message: "{_ __child.translation_namespace__.child_ui.error_archiving}",
						duration: 4000,
					});
				}
			});
		}
	})();
</script>
{/if}
<!-- GEN:CHILDREN:END -->
