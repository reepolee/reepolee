{#each props.records as record}
	<!-- GEN:CUSTOM:ROW_PREFIX:START -->
	<!-- GEN:CUSTOM:ROW_PREFIX:END -->
	<a href="{~ localized_path('/__route_prefix__/__table.exact__/' + record.__route_param__ + '/edit') }"
		class="col-span-full *:py-2 grid cursor-pointer grid-cols-subgrid border-b border-b-neutral-200 *:px-2 hover:bg-primary hover:text-white">

		{#if props.enable_archive}
			<div class="grid grid-cols-2 place-items-center p-0! m-0!">
				<button class="as-icon size-6 text-neutral-600 cursor-grab hover:text-white"
					onclick="event.stopPropagation();event.preventDefault()">
					<ree-icon name="grip"></ree-icon>
				</button>
				<label class="w-full h-full grid place-items-center hover:bg-brand rounded">
					<input type="checkbox" name="checkboxes[]" value="{= record.id }">
				</label>
			</div>
		{/if}

		<!-- marker cell for the ws "updated record" bullet - filled by updates-client.js -->
		<div class="updates-marker-cell" data-record-id="{= record.id }"></div>
		<div>{= record.id }</div>
		__table.cells__
		<!-- filler cell for the trailing grid_filler track in grid_cols -->
		<div class="grid-filler">__archive.row_restore__</div>
	</a>
{/each}
