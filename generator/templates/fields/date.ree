<field-wrapper class="grid lg:col-span-2 lg:grid-cols-subgrid" data-field="__field.name__">
	<div class="grid">
		<label class="px-3" for="__field.name__">{_ labels.__field.name__} ({_ hints.date_format_value })</label>
		<date-input id="__field.name__" name="__field.name__" value="{~ js_date_to_iso_string(record.__field.name__)}" locale="{= props.locale }" ...props.translations.errors></date-input>
		<validation-error class="mt-1" id="error-__field.name__"></validation-error>
	</div>
</field-wrapper>
